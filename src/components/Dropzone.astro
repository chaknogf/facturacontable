---
interface Props {
  id?: string;
  accept?: string;
  multiple?: boolean;
  label?: string;
  hint?: string;
  class?: string;
}

const {
  id = "dropzone",
  accept = ".xml",
  multiple = true,
  label = "Arrastra tus archivos XML aquí",
  hint = "o toca para seleccionar · 100% privado, no se sube nada al servidor",
  class: className = "",
} = Astro.props;
---

<div
  id={id}
  class={`dropzone ${className}`}
  role="button"
  tabindex="0"
  aria-label={label}
  data-accept={accept}
  data-multiple={String(multiple)}
>
  <input
    id={`${id}-input`}
    type="file"
    accept={accept}
    multiple={multiple}
    hidden
    aria-hidden="true"
    tabindex="-1"
  />
  <div class="dropzone__icon" aria-hidden="true">📂</div>
  <p class="dropzone__label">{label}</p>
  <p class="dropzone__hint">{hint}</p>
  <span class="brutal-btn brutal-btn--primary dropzone__cta" aria-hidden="true">Seleccionar archivos</span>
  <p class="mono dropzone__privacy">🔒 Todo se procesa en tu navegador</p>
</div>

<style>
  .dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 2rem 1rem;
    min-height: 220px;
    background: var(--surface);
    border: 2.5px dashed var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-align: center;
    cursor: pointer;
    transition: background 0.15s, transform 0.08s, box-shadow 0.08s, border-color 0.15s;
    user-select: none;
  }

  .dropzone:hover {
    background: var(--bg-soft);
  }

  .dropzone:focus-visible {
    outline: 3px solid var(--accent-3);
    outline-offset: 2px;
  }

  .dropzone--dragging {
    background: var(--primary) !important;
    border-style: solid !important;
    border-color: var(--border) !important;
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-lg) !important;
  }

  .dropzone--dragging .dropzone__icon {
    transform: scale(1.15) rotate(-4deg);
  }

  .dropzone__icon {
    font-size: 2.4rem;
    line-height: 1;
    transition: transform 0.15s;
  }

  .dropzone__label {
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.015em;
  }

  .dropzone__hint {
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: 32ch;
  }

  .dropzone__cta {
    margin-top: 0.4rem;
    pointer-events: none;
  }

  .dropzone__privacy {
    font-size: 0.7rem;
    color: var(--text-muted);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 10px;
    margin-top: 0.25rem;
  }

  @media (min-width: 768px) {
    .dropzone { padding: 2.5rem 1.5rem; min-height: 240px; }
    .dropzone__label { font-size: 1.25rem; }
  }
</style>

<script is:inline define:vars={{ id }}>
  (function () {
    const zone = document.getElementById(id);
    const input = document.getElementById(id + "-input");
    if (!zone || !input) return;

    function openPicker() { input.click(); }

    zone.addEventListener("click", openPicker);
    zone.addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        openPicker();
      }
    });

    ["dragenter", "dragover"].forEach(function (ev) {
      zone.addEventListener(ev, function (e) {
        e.preventDefault();
        zone.classList.add("dropzone--dragging");
      });
    });

    ["dragleave", "drop"].forEach(function (ev) {
      zone.addEventListener(ev, function (e) {
        e.preventDefault();
        zone.classList.remove("dropzone--dragging");
      });
    });

    zone.addEventListener("drop", function (e) {
      const dt = e.dataTransfer;
      if (!dt || !dt.files || dt.files.length === 0) return;
      // Reenvía al input para que el listener externo (change) lo capture
      // Creamos un DataTransfer sintético si el navegador lo permite
      try {
        const d = new DataTransfer();
        for (let i = 0; i < dt.files.length; i++) d.items.add(dt.files[i]);
        input.files = d.files;
      } catch (_) {
        // Fallback: dispara evento custom con files
        const evt = new CustomEvent("dropzone:files", { detail: { files: dt.files } });
        zone.dispatchEvent(evt);
        return;
      }
      input.dispatchEvent(new Event("change", { bubbles: true }));
    });

    // Evita que el browser abra el archivo si se suelta fuera
    document.addEventListener("dragover", function (e) { e.preventDefault(); });
    document.addEventListener("drop", function (e) { e.preventDefault(); });
  })();
</script>
