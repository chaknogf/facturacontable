---
/**
 * AdBanner — Bloque reutilizable Google AdSense (rentable + Lighthouse 100)
 * Dev: placeholder Neo-Brutalista con ubicación (Hero/Conversión/FAQ)
 * Prod: <ins class="adsbygoogle" ... data-ad-format="auto" data-full-width-responsive="true">
 * Offline/Pro: maneja estados sin conexión y licencia Pro
 */
interface Props {
  slot?: string;
  format?: "auto" | "horizontal" | "vertical" | "rectangle";
  /** Texto junto a-badge PUBLICIDAD */
  label?: string;
  /** Ubicación descriptiva para Dev placeholder y data-attr */
  location?: string;
  /** Compat: Astro permite `class`, spec pide `className` — soporta ambos */
  class?: string;
  className?: string;
  style?: string;
  debug?: boolean;
}

const {
  slot = "0000000000",
  format = "auto",
  label = "PUBLICIDAD",
  location,
  class: classProp = "",
  className = "",
  style = "",
  debug = false,
} = Astro.props;

const isDev = import.meta.env.DEV;
const mergedClass = [classProp, className].filter(Boolean).join(" ");

const placeholderHeights: Record<string, string> = {
  auto: "120px",
  horizontal: "90px",
  rectangle: "250px",
  vertical: "300px",
};

const placeholderHeight = placeholderHeights[format] ?? "120px";
const adId = `ad-${slot}-${format}-${Math.random().toString(36).slice(2, 7)}`;
const locationLabel = location ? `Ubicación: ${location}` : `slot: ${slot} · format: ${format}`;
---

<div
  class={`ad-banner ${mergedClass}`}
  data-ad-slot={slot}
  data-ad-format={format}
  data-ad-location={location ?? ""}
  style={style}
>
  {/* Contenedor offline — oculto por defecto, se muestra vía JS si !navigator.onLine */}
  <div class="ad-offline" style="display:none;" aria-live="polite">
    <div class="ad-offline__card">
      <span aria-hidden="true" style="font-size:1.2rem;">⚡</span>
      <p style="font-weight:800;font-size:0.92rem;">Modo Offline Activo. Trabajando sin internet de forma privada.</p>
      <p class="mono" style="font-size:0.7rem;color:var(--text-muted);">Tus archivos nunca salen de tu dispositivo</p>
    </div>
  </div>

  {/* Contenedor Pro — oculto, se muestra si user_pro_unlocked */}
  <div class="ad-pro" style="display:none;" aria-hidden="true"></div>

  {
    isDev || debug ? (
      <div
        class="ad-placeholder"
        style={`min-height:${placeholderHeight};`}
        role="complementary"
        aria-label={`Espacio publicitario ${location ?? slot}`}
      >
        <div class="ad-placeholder__badge">{label}</div>
        <div class="ad-placeholder__body">
          <span class="ad-placeholder__icon" aria-hidden="true">📢</span>
          <p class="ad-placeholder__title">Espacio de Anuncio AdSense</p>
          <p class="ad-placeholder__loc mono">{location ? `📍 ${location}` : `format: ${format}`}</p>
          <p class="ad-placeholder__hint mono">{locationLabel} · En producción se mostrará el anuncio real</p>
        </div>
        <span class="ad-placeholder__adsense mono">adsbygoogle · responsive</span>
      </div>
    ) : null
  }

  <ins
    id={adId}
    class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive="true"
    aria-hidden={isDev ? "true" : undefined}
  ></ins>
</div>

{!isDev && (
  <script is:inline define:vars={{ adId }}>
    (function () {
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch (e) {
        console.warn("[AdBanner] adsbygoogle push falló:", e);
      }
    })();
  </script>
)}

<!-- Lógica Offline + Pro (client-side) -->
<script is:inline define:vars={{ adId, slot }}>
  (function(){
    const banner = document.getElementById(adId)?.closest('.ad-banner');
    if(!banner) return;
    const offlineEl = banner.querySelector('.ad-offline');
    const placeholder = banner.querySelector('.ad-placeholder');
    const ins = banner.querySelector('.adsbygoogle');

    function isPro(){
      try {
        return localStorage.getItem('user_pro_unlocked') === 'true' || !!localStorage.getItem('license_key');
      } catch(e){ return false; }
    }
    function isOffline(){
      return typeof navigator !== 'undefined' && !navigator.onLine;
    }
    function apply(){
      const pro = isPro();
      const offline = isOffline();
      if(pro){
        // Oculta completamente anuncios — requisito Pro
        if(offlineEl) offlineEl.style.display = 'none';
        if(placeholder) placeholder.style.display = 'none';
        if(ins) ins.style.display = 'none';
        banner.style.display = 'none';
        banner.setAttribute('data-pro-hidden','true');
        return;
      }
      if(offline){
        if(placeholder) placeholder.style.display = 'none';
        if(ins) ins.style.display = 'none';
        if(offlineEl) offlineEl.style.display = 'block';
        banner.setAttribute('data-offline','true');
      } else {
        if(offlineEl) offlineEl.style.display = 'none';
        banner.removeAttribute('data-offline');
        // restaura placeholder/ins según entorno
        const isDev = banner.querySelector('.ad-placeholder') !== null;
        // no tocar display de ins/placeholder si ya están correctos
      }
    }
    apply();
    window.addEventListener('online', apply);
    window.addEventListener('offline', apply);
    window.addEventListener('storage', apply);
    // escucha evento custom de Pro unlock
    window.addEventListener('pro-unlocked', apply);
    // Para SPA/astro transitions
    document.addEventListener('astro:page-load', apply);
  })();
</script>

<style>
  .ad-banner {
    width: 100%;
    /* Requisito AdSense: margen respirable para evitar clics accidentales en móvil */
    margin: 1.5rem 0;
    /* Evita layout shift */
    contain: content;
  }

  .ad-placeholder {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 1.35rem 1rem 1.6rem;
    background: repeating-linear-gradient(
      45deg,
      var(--bg-soft),
      var(--bg-soft) 10px,
      var(--surface) 10px,
      var(--surface) 20px
    );
    border: 2px solid var(--border);
    /* Dev puede usar dashed para diferenciar, prod es sólido */
    border-style: dashed;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    text-align: center;
    overflow: hidden;
  }

  [data-theme="dark"] .ad-placeholder {
    background: repeating-linear-gradient(45deg, #0a3d5c, #0a3d5c 10px, #0e4a6b 10px, #0e4a6b 20px);
  }

  .ad-placeholder__badge {
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    background: var(--primary);
    color: var(--secundary);
    border: 1.5px solid var(--border);
    border-radius: 999px;
    padding: 2px 8px;
    box-shadow: 1.5px 1.5px 0 var(--border);
  }

  .ad-placeholder__icon { font-size: 1.45rem; }

  .ad-placeholder__title {
    font-weight: 800;
    font-size: 0.92rem;
    letter-spacing: -0.01em;
  }

  .ad-placeholder__loc {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text);
    background: var(--primary);
    border: 1.5px solid var(--border);
    border-radius: 999px;
    padding: 2px 10px;
    box-shadow: 1.5px 1.5px 0 var(--border);
  }

  .ad-placeholder__hint {
    font-size: 0.68rem;
    color: var(--text-muted);
    max-width: 34ch;
    line-height: 1.4;
  }

  .ad-placeholder__adsense {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.58rem;
    color: var(--text-muted);
    opacity: 0.7;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ad-offline__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 1.1rem 1rem;
    min-height: 88px;
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }

  .adsbygoogle {
    display: block;
    min-height: 90px;
    /* Espacio interno para que el anuncio no quede pegado al borde */
    overflow: hidden;
    border-radius: var(--radius-sm);
  }
  /* En producción, si el anuncio no llena, evita CLS */
  .adsbygoogle:empty {
    min-height: 90px;
  }
</style>
