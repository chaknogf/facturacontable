        b.style.borderColor = isActive ? 'var(--border)' : 'var(--border)';
        b.style.boxShadow = isActive ? '3px 3px 0 var(--border)' : '2px 2px 0 var(--border)';
        b.style.fontWeight = isActive ? '800' : '700';
      });
      const sel = document.getElementById('country-select') as HTMLSelectElement | null;
      if(sel) sel.value = selectedCountry;
      // SEO dinámico
      const seoTitle = document.getElementById('seo-title');
      const seoTag = document.getElementById('seo-pais-tag');
      if(seoTitle) seoTitle.textContent = `Guía: descargar XML ${cfg.ente} y convertir a PDF — ${cfg.label}`;
      if(seoTag) seoTag.textContent = `${cfg.flag} ${cfg.label} · UBL / CFDI / FEL`;
      document.title = `XML ${cfg.shortLabel} a PDF — ${cfg.ente} | FacturaContable.gt`;
    }

    function initCountrySwitch(){
      const wrap = document.getElementById('country-switch') as HTMLElement | null;
      const sel = document.getElementById('country-select') as HTMLSelectElement | null;
      if(!wrap) return;
      const countries: CountryId[] = ['gt','mx','co','pe','ec','latam'];
      wrap.innerHTML = countries.map(id=>{
        const c = COUNTRY_CONFIGS[id];
        const isActive = id===selectedCountry;
        return `<button type="button" role="tab" data-country="${id}" aria-pressed="${isActive}" aria-selected="${isActive}"
          style="flex:1 1 auto;min-width:92px;min-height:48px;display:inline-flex;align-items:center;justify-content:center;gap:0.35rem;padding:0 0.85rem;background:${isActive?'var(--primary)':'var(--surface)'};border:2px solid var(--border);border-radius:999px;box-shadow:${isActive?'3px 3px 0 var(--border)':'2px 2px 0 var(--border)'};font-weight:${isActive?'800':'700'};font-size:0.82rem;cursor:pointer;white-space:nowrap;">
          <span aria-hidden="true">${c.flag}</span><span>${c.shortLabel}</span>
        </button>`;
      }).join('');
      // pills click
      wrap.querySelectorAll<HTMLButtonElement>('button[data-country]').forEach(btn=>{
        btn.addEventListener('click', ()=>{
          const id = btn.getAttribute('data-country') as CountryId;
          saveCountry(id);
        });
      });
      if(sel){
        sel.innerHTML = countries.map(id=>{
          const c=COUNTRY_CONFIGS[id];
          return `<option value="${id}">${c.flag} ${c.label}</option>`;
        }).join('');
        sel.value = selectedCountry;
        sel.style.display = 'none'; // solo fallback accesible, usamos pills
        sel.addEventListener('change', ()=> saveCountry(sel.value as CountryId));
      }
      updateCountryUI();
      // responsive: en móvil pills hacen wrap, en desktop en fila
      const style = document.createElement('style');
      style.textContent = '#country-switch{justify-content:flex-start;} @media(max-width:480px){#country-switch button{flex:1 1 calc(50% - 0.5rem);}}';
      document.head.appendChild(style);
    }

    // Wrapper universal — usa xmlParser con auto-detección + fallback manual
    function parseXML(text: string, fileName: string): Factura {
      // detecta antes para hint UI
      try {
        const tmpDoc = new DOMParser().parseFromString(text, 'application/xml');
        const detected = detectCountry(text, tmpDoc);
        const hint = document.getElementById('country-auto-hint');
        if(detected && detected !== selectedCountry){
          if(hint) hint.textContent = `Detectado ${COUNTRY_CONFIGS[detected].flag} ${COUNTRY_CONFIGS[detected].label} — cambiando`;
          // auto-cambia al detectado (UX multi-país)
          selectedCountry = detected;
          try{ localStorage.setItem('fc_country', detected); }catch{}
          updateCountryUI();
        } else if(detected && hint){
          hint.textContent = `${COUNTRY_CONFIGS[detected].flag} Detectado ${COUNTRY_CONFIGS[detected].ente} · Auto`;
        }
      } catch {}
      return parseFactura(text, fileName, selectedCountry);
    }

    function formatMoney(v: string | undefined, moneda?: string): string {
      if (!v || v === "—") return "—";
      // Usa config del país activo o del que viene en la factura
      // Si la factura ya trae country, usa esa config
      // Aquí `moneda` ya no es GTQ fijo, delega a formatMoneyForCountry
      const cfg = getActiveConfig();
      // Si la factura trae moneda distinta, prioriza la de la factura
      // Pero formatMoneyForCountry usa cfg.currencyCode; si la factura es de otro país, caller pasará moneda correcta
      // Para compat, si moneda es GTQ/MXN/etc., busca config correspondiente
      let targetCfg = cfg;
      if(moneda){
        const found = (Object.values(COUNTRY_CONFIGS) as CountryConfig[]).find(c=> c.currencyCode===moneda || c.currency===moneda);
        if(found) targetCfg = found;
      } else if(facturas[0]?.currencySymbol){
        // no-op
      }
      return formatMoneyForCountry(v, targetCfg);
    }

    function getBrandingForPdf(f: Factura): { palette: Palette; font: string; displayName: string; logoBase64: string | null } {
      const palette = getPalette();
      const displayName = branding.businessName?.trim() || f.emisorNombre || "—";
      let logoBase64: string | null = null;
      if (branding.iconMode === "upload") {
        logoBase64 = branding.logoBase64;
      } else if (branding.iconMode === "avatar") {
        // regenerate on the fly to pick latest name/palette
        logoBase64 = generateAvatarBase64(displayName, palette.primary);
      }
      return { palette, font: branding.font, displayName, logoBase64 };
    }

    function buildDocDefinition(f: Factura, formato: string): any {
      const { palette, font, displayName, logoBase64 } = getBrandingForPdf(f);
      const cfg: CountryConfig = getCountryConfig((f.country as CountryId) ?? selectedCountry);
      const moneda = f.moneda ?? cfg.currencyCode;
      const isTicket = formato === "ticket";
      const titulo = isTicket ? `${cfg.ente} — ${cfg.shortLabel}` : `Documento Tributario Electrónico — ${cfg.ente}`;
      const idLabelEmisor = (f as any).emisorIdLabel ?? cfg.idLabel;
      const idLabelReceptor = (f as any).receptorIdLabel ?? cfg.idLabelReceptor;
      const emisorIdVal = (f as any).emisorId ?? (f as any).emisorNIT ?? "—";
      const receptorIdVal = (f as any).receptorId ?? (f as any).receptorNIT ?? "—";

      // Header with logo/avatar if present
      const headerBranding: any[] = [];
      if (logoBase64) {
        headerBranding.push({
          columns: [
            {
              image: logoBase64,
              width: isTicket ? 36 : 48,
              height: isTicket ? 36 : 48,
              margin: [0, 0, 8, 6],
            },
            {
              width: "*",
              stack: [
                { text: displayName, fontSize: isTicket ? 9 : 11, bold: true, color: palette.primary, margin: [0, isTicket ? 2 : 4, 0, 2] },
                { text: `${idLabelEmisor}: ${emisorIdVal}`, fontSize: 7, color: "#444" },
                ...(f.emisorDireccion && !isTicket ? [{ text: f.emisorDireccion, fontSize: 7, color: "#444" }] : []),
              ],
            },
          ],
          columnGap: 6,
          margin: [0, 0, 0, 6],
        });
      } else {
        headerBranding.push({
          text: displayName,
          fontSize: isTicket ? 10 : 12,
          bold: true,
          color: palette.primary,
          alignment: isTicket ? "center" : "left",
          margin: [0, 0, 0, 2],
        });
        if (!isTicket) {
          headerBranding.push({
            text: `${idLabelEmisor}: ${emisorIdVal}${f.emisorDireccion ? " · " + f.emisorDireccion : ""}`,
            fontSize: 7,
            color: "#444",
            margin: [0, 0, 0, 6],
          });
        } else {
          headerBranding.push({
            text: `${idLabelEmisor}: ${emisorIdVal}`,
            fontSize: 7,
            color: "#444",
            alignment: "center",
            margin: [0, 0, 0, 6],
          });
        }
      }

      const commonStyles = {
        header: { fontSize: isTicket ? 9 : 13, bold: true, color: palette.primary },
        sub: { fontSize: isTicket ? 7 : 8, color: "#444" },
        tableHeader: { bold: true, fontSize: isTicket ? 7 : 8, color: "white", fillColor: palette.primary },
        total: { bold: true, fontSize: isTicket ? 8 : 10 },
      };

      // === TICKET minimalista: lista limpia ===
      if (isTicket) {
        const ticketItems: any[] = [];
        f.items.forEach((it, idx) => {
          const qty = (it.cantidad ?? "1").toString();
          const desc = it.descripcion || `Item ${idx + 1}`;
          const total = it.total ? formatMoney(it.total, moneda) : it.precio ? formatMoney(it.precio, moneda) : "—";
          ticketItems.push({
            columns: [
              { text: `${qty}x ${desc}`, fontSize: 7, margin: [0, 2, 0, 0], width: "*" },
              { text: total, fontSize: 7, bold: true, alignment: "right", width: 52, margin: [6, 2, 0, 0] },
            ],
            columnGap: 4,
          });
          // dashed separator
          if (idx < f.items.length - 1) {
            ticketItems.push({
              canvas: [{ type: "line", x1: 0, y1: 4, x2: 210, y2: 4, lineWidth: 0.6, dash: { length: 2 }, lineColor: "#bbb" }],
              margin: [0, 0, 0, 0],
            });
          }
        });

        // Total + foot for ticket
        const content: any[] = [
          { text: titulo, style: "header", alignment: "center", margin: [0, 0, 0, 2] },
          {
            text: `${cfg.ente} · ${cfg.flag} ${cfg.shortLabel} · ${f.serie ?? ""} ${f.numero ?? ""} ${(f as any).folioFiscal ? "· " + String((f as any).folioFiscal).slice(0,22)+"…" : ""}`.trim(),
            style: "sub",
            alignment: "center",
            margin: [0, 0, 0, 6],
          },
          // dashed top
          { canvas: [{ type: "line", x1: 0, y1: 0, x2: 210, y2: 0, lineWidth: 0.7, dash: { length: 3 }, lineColor: palette.accent }], margin: [0, 0, 0, 6] },
          ...headerBranding,
          { canvas: [{ type: "line", x1: 0, y1: 0, x2: 210, y2: 0, lineWidth: 0.5, lineColor: "#ddd" }], margin: [0, 4, 0, 6] },
          // Receptor + fecha compact
          {
            stack: [
              { text: `Cliente: ${f.receptorNombre ?? "—"}`, fontSize: 7, bold: true },
              { text: `${idLabelReceptor}: ${receptorIdVal}`, fontSize: 6, color: "#555" },
              ...(f.fechaEmision ? [{ text: `Fecha: ${f.fechaEmision.slice(0, 10)}`, fontSize: 6, color: "#555" }] : []),
            ],
            margin: [0, 0, 0, 6],
          },
          { canvas: [{ type: "line", x1: 0, y1: 0, x2: 210, y2: 0, lineWidth: 0.7, dash: { length: 3 }, lineColor: palette.accent }], margin: [0, 0, 0, 6] },
          ...ticketItems,
          { canvas: [{ type: "line", x1: 0, y1: 6, x2: 210, y2: 6, lineWidth: 0.7, dash: { length: 3 }, lineColor: palette.accent }], margin: [0, 0, 0, 6] },
          {
            columns: [
              { text: "TOTAL", fontSize: 8, bold: true, color: palette.primary },
              { text: formatMoney(f.granTotal, moneda), fontSize: 9, bold: true, alignment: "right", color: palette.primary },
            ],
            margin: [0, 2, 0, 0],
          },
          ...(f.iva ? [{ text: `${(f as any).taxLabel ?? cfg.taxLabel} incluido: ${formatMoney(f.iva, moneda)}`, fontSize: 6, color: "#666", alignment: "right", margin: [0, 2, 0, 0] }] : []),
          ...((f as any).folioFiscal ? [{ text: `Folio: ${(f as any).folioFiscal}`, fontSize: 5, color: "#999", alignment: "center", margin: [0, 8, 0, 0] }] : (f as any).numeroAcceso ? [{ text: `Acceso: ${(f as any).numeroAcceso}`, fontSize: 5, color: "#999", alignment: "center", margin: [0, 8, 0, 0] }] : []),
          {
            text: `XML original es el único comprobante válido ante ${cfg.ente}.`,
            fontSize: 5,
            color: "#999",
            alignment: "center",
            margin: [0, 6, 0, 0],
          },
          {
            text: `FacturaContable.gt · 100% navegador · ${cfg.flag}`,
            fontSize: 5,
            color: "#aaa",
            alignment: "center",
            margin: [0, 2, 0, 0],
          },
        ];

        // Alto dinámico: base 220 + 18 por item + logo extra, clamped 320..1200
        const base = 220;
        const perItem = 18;
        const logoExtra = logoBase64 ? 30 : 0;
        const h = Math.min(1200, Math.max(320, base + f.items.length * perItem + logoExtra + (f.numeroAcceso ? 12 : 0)));

        return {
          pageSize: { width: 226.77, height: h },
          pageMargins: [8, 10, 8, 10],
          content,
          styles: commonStyles,
          defaultStyle: { font: font, fontSize: 7, color: "#111" },
        };
      }

      // === CARTA / MEDIA: tabla con branding ===
      const itemsBody: any[] = [
        [
          { text: "#", style: "tableHeader", alignment: "center" },
          { text: "Descripción", style: "tableHeader" },
          { text: "Cant.", style: "tableHeader", alignment: "center" },
          { text: "Precio", style: "tableHeader", alignment: "right" },
          { text: "Total", style: "tableHeader", alignment: "right" },
        ],
        ...f.items.map((it, idx) => [
          { text: String(idx + 1), fontSize: 8, alignment: "center" },
          { text: it.descripcion, fontSize: 8 },
          { text: String(it.cantidad), fontSize: 8, alignment: "center" },
          { text: it.precio ? formatMoney(it.precio, moneda) : "—", fontSize: 8, alignment: "right" },
          { text: it.total ? formatMoney(it.total, moneda) : "—", fontSize: 8, alignment: "right" },
        ]),
      ];

      const isMedia = formato === "media";
      const content: any[] = [
        { text: titulo, style: "header", alignment: "center", margin: [0, 0, 0, 4] },
        {
          text: `${cfg.ente} · ${cfg.flag} ${cfg.shortLabel} · ${f.serie ?? ""} ${f.numero ?? ""} ${(f as any).folioFiscal ? "· " + String((f as any).folioFiscal).slice(0,22)+"…" : (f as any).numeroAcceso ? "· " + String((f as any).numeroAcceso).slice(0,22)+"…" : ""}`.trim(),
          style: "sub",
          alignment: "center",
          margin: [0, 0, 0, 8],
        },
        ...headerBranding,
        {
          columns: [
            {
              width: "*",
              stack: [
                { canvas: [{ type: "line", x1: 0, y1: 0, x2: 80, y2: 0, lineWidth: 2, lineColor: palette.accent }], margin: [0, 0, 0, 4] },
                { text: "RECEPTOR", fontSize: 7, bold: true, color: palette.primary, margin: [0, 0, 0, 2] },
                { text: f.receptorNombre ?? "—", fontSize: 9, bold: true },
                { text: `${idLabelReceptor}: ${receptorIdVal}`, fontSize: 7, color: "#444" },
                ...(f.receptorDireccion ? [{ text: f.receptorDireccion, fontSize: 7, color: "#444" }] : []),
                ...(f.fechaEmision ? [{ text: `Fecha: ${f.fechaEmision}`, fontSize: 7, color: "#444", margin: [0, 4, 0, 0] }] : []),
                { text: `Moneda: ${moneda}`, fontSize: 7, color: "#444" },
              ],
            },
          ],
          margin: [0, 0, 0, 10],
        },
        {
          table: { headerRows: 1, widths: isMedia ? [18, "*", 30, 50, 50] : [18, "*", 36, 58, 58], body: itemsBody },
          layout: {
            fillColor: (rowIndex: number) => (rowIndex === 0 ? palette.primary : rowIndex % 2 === 0 ? "#F5F0E8" : null),
            hLineWidth: () => 0.5,
            vLineWidth: () => 0.5,
            hLineColor: () => "#111111",
            vLineColor: () => "#111111",
          },
          margin: [0, 0, 0, 8],
        },
        {
          columns: [
            { width: "*", text: "" },
            {
              width: 180,
              stack: [
                {
                  columns: [
                    { text: "Gran Total", fontSize: 8, bold: true, color: palette.primary },
                    { text: formatMoney(f.granTotal, moneda), fontSize: 10, bold: true, alignment: "right", color: palette.primary },
                  ],
                  margin: [0, 0, 0, 2],
                },
                ...(f.iva
                  ? [{ text: `${(f as any).taxLabel ?? cfg.taxLabel} incluido: ${formatMoney(f.iva, moneda)}`, fontSize: 7, color: "#666", alignment: "right" }]
                  : []),
                ...((f as any).folioFiscal
                  ? [{ text: `Folio: ${(f as any).folioFiscal}`, fontSize: 6, color: "#888", alignment: "right", margin: [0, 6, 0, 0] }]
                  : (f as any).numeroAcceso
                  ? [{ text: `No. Acceso: ${(f as any).numeroAcceso}`, fontSize: 6, color: "#888", alignment: "right", margin: [0, 6, 0, 0] }]
                  : []),
              ],
            },
          ],
        },
        {
          canvas: [{ type: "line", x1: 0, y1: 8, x2: 540, y2: 8, lineWidth: 1, lineColor: palette.accent }],
          margin: [0, 0, 0, 0],
        },
        {
          text: `Documento generado localmente desde el XML original. El XML es el único comprobante con validez tributaria ante ${cfg.ente}.`,
          fontSize: 6,
          color: "#888",
          alignment: "center",
          margin: [0, 8, 0, 0],
        },
        {
          text: `FacturaContable.gt · 100% en tu navegador · Hecho en LATAM ${cfg.flag}`,
          fontSize: 6,
          color: "#888",
          alignment: "center",
          margin: [0, 2, 0, 0],
        },
      ];

      if (isMedia) {
        return {
          pageSize: "A5",
          pageOrientation: "landscape",
          pageMargins: [18, 16, 18, 16],
          content,
          styles: commonStyles,
          defaultStyle: { font: font, fontSize: 8, color: "#111" },
        };
      }
      return {
        pageSize: "LETTER",
        pageMargins: [28, 22, 28, 22],
        content,
        styles: commonStyles,
        defaultStyle: { font: font, fontSize: 9, color: "#111" },
      };
    }

    async function downloadFactura(f: Factura, formato: string) {
      const docDef = buildDocDefinition(f, formato);
      const base = (f.fileName || "DTE").replace(/\.xml$/i, "");
      const suf = formato === "carta" ? "Carta" : formato === "media" ? "MediaCarta" : "Ticket80mm";
      try {
        const pdfMake = await getPdfMake();
        const _out = `${base}_${suf}.pdf`;
        (pdfMake.createPdf(docDef) as any).download(_out);
      } catch (e) {
        console.error(e);
        pushError(`No se pudo generar el PDF para ${f.fileName}: ${(e as Error).message}`);
      }
    }

    function pushError(msg: string) {
      if (!erroresEl) return;
      erroresEl.style.display = "grid";
      const div = document.createElement("div");
      div.setAttribute("style", "padding:0.75rem 1rem;background:#FFE5E5;border:2px solid #111;border-radius:12px;box-shadow:3px 3px 0 #111;font-size:0.9rem;display:flex;gap:0.5rem;align-items:flex-start;");
      div.innerHTML = `<span aria-hidden="true">⚠️</span><span style="flex:1;">${msg}</span><button class="mono" style="background:white;border:1.5px solid #111;border-radius:999px;padding:2px 10px;cursor:pointer;font-weight:700;font-size:0.75rem;flex-shrink:0;" onclick="this.parentElement.remove()">Cerrar</button>`;
      erroresEl.appendChild(div);
    }

    function render() {
      if (!lista || !emptyEl || !controlsEl || !resumenEl) return;
      lista.innerHTML = "";
      if (facturas.length === 0) {
        emptyEl.style.display = "block";
        controlsEl.style.display = "none";
        resumenEl.textContent = "";
        return;
      }
      emptyEl.style.display = "none";
      controlsEl.style.display = "grid";
      const pal = getPalette();
      resumenEl.innerHTML = `${facturas.length} archivo(s) listo(s) · <span style="display:inline-block;width:10px;height:10px;border-radius:999px;background:${pal.primary};border:1.5px solid var(--border);vertical-align:middle;margin:0 4px;"></span> ${pal.label} · ${branding.font} · Formato: ${formatoSel.value === "carta" ? "Carta" : formatoSel.value === "media" ? "Media Carta" : "Ticket 80mm"}`;

      facturas.forEach((f, idx) => {
        const displayName = branding.businessName?.trim() || f.emisorNombre || "—";
        const logoForCard = branding.iconMode === "upload" ? branding.logoBase64 : branding.iconMode === "avatar" ? generateAvatarBase64(displayName, pal.primary) : null;
        const card = document.createElement("div");
        card.setAttribute("style", "display:grid;gap:0.65rem;padding:1rem;background:var(--surface);border:2px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);");
        card.innerHTML = `
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;justify-content:space-between;align-items:flex-start;">
            <div style="display:flex;gap:0.6rem;align-items:center;min-width:0;flex:1;">
              ${logoForCard ? `<img src="${logoForCard}" alt="logo" style="width:40px;height:40px;object-fit:contain;background:white;border:2px solid var(--border);border-radius:10px;box-shadow:2px 2px 0 var(--border);flex-shrink:0;" />` : ""}
              <div style="display:grid;gap:0.15rem;min-width:0;flex:1;">
                <p class="mono" style="font-size:0.72rem;font-weight:800;letter-spacing:0.04em;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${f.fileName} ${f.serie || f.numero ? "· " + (f.serie ?? "") + " " + (f.numero ?? "") : ""}</p>
                <p style="font-weight:800;font-size:0.98rem;letter-spacing:-0.01em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${displayName} <span style="font-weight:400;color:var(--text-muted);">→</span> ${f.receptorNombre ?? "—"}</p>
                <p class="mono" style="font-size:0.75rem;color:var(--text-muted);">${(f as any).emisorIdLabel ?? getCountryConfig(f.country).idLabel}: ${(f as any).emisorId ?? (f as any).emisorNIT ?? "—"} · ${(f as any).receptorIdLabel ?? getCountryConfig(f.country).idLabelReceptor}: ${(f as any).receptorId ?? (f as any).receptorNIT ?? "—"} ${f.fechaEmision ? "· " + f.fechaEmision.slice(0, 10) : ""} · ${getCountryConfig(f.country).flag} ${getCountryConfig(f.country).shortLabel} · ${(f as any).taxLabel ?? getCountryConfig(f.country).taxLabel}</p>
              </div>
            </div>
            <span class="mono" style="background:${pal.primary};color:white;border:1.5px solid var(--border);border-radius:999px;padding:4px 10px;font-weight:800;font-size:0.8rem;box-shadow:2px 2px 0 var(--border);white-space:nowrap;">${formatMoney(f.granTotal, f.moneda)}</span>
          </div>
          <div style="overflow:auto;border:1.5px solid var(--border);border-radius:10px;">
            <table class="mono" style="width:100%;border-collapse:collapse;font-size:0.75rem;min-width:420px;">
              <thead><tr style="background:${pal.primary};color:white;text-align:left;"><th style="padding:6px 8px;border-bottom:1.5px solid var(--border);">Descripción</th><th style="padding:6px 8px;border-bottom:1.5px solid var(--border);text-align:center;">Cant.</th><th style="padding:6px 8px;border-bottom:1.5px solid var(--border);text-align:right;">Precio</th><th style="padding:6px 8px;border-bottom:1.5px solid var(--border);text-align:right;">Total</th></tr></thead>
              <tbody>
                ${f.items.slice(0, 12).map(it => `<tr><td style="padding:6px 8px;border-bottom:1px solid #eee;max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${it.descripcion}</td><td style="padding:6px 8px;border-bottom:1px solid #eee;text-align:center;">${it.cantidad}</td><td style="padding:6px 8px;border-bottom:1px solid #eee;text-align:right;">${it.precio ? formatMoney(it.precio, f.moneda) : "—"}</td><td style="padding:6px 8px;border-bottom:1px solid #eee;text-align:right;">${it.total ? formatMoney(it.total, f.moneda) : "—"}</td></tr>`).join("")}
                ${f.items.length > 12 ? `<tr><td colspan="4" style="padding:6px 8px;text-align:center;color:var(--text-muted);">… y ${f.items.length - 12} ítem(s) más (ver PDF completo)</td></tr>` : ""}
              </tbody>
            </table>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
            <button data-idx="${idx}" data-action="download" class="brutal-btn brutal-btn--primary" style="flex:1;min-width:160px;background:${pal.primary};color:white;border-color:var(--border);">⬇️ Descargar PDF</button>
            <button data-idx="${idx}" data-action="remove" class="brutal-btn brutal-btn--ghost" style="min-width:88px;">Quitar</button>
          </div>
        `;
        lista.appendChild(card);
      });

      lista.querySelectorAll<HTMLButtonElement>("button[data-action]").forEach((b) => {
        b.addEventListener("click", () => {
          const idx = Number(b.getAttribute("data-idx"));
          const action = b.getAttribute("data-action");
          if (action === "remove") {
            facturas.splice(idx, 1);
            render();
          } else if (action === "download") {
            const fmt = formatoSel.value;
            downloadFactura(facturas[idx], fmt);
          }
        });
      });
    }

    async function handleFiles(fileList: FileList | File[]) {
      const files = Array.from(fileList).filter((f) => f.name.toLowerCase().endsWith(".xml") || f.type.includes("xml") || true);
      if (files.length === 0) {
        pushError("No se detectaron archivos XML. Asegúrate de seleccionar archivos .xml del SAT.");
        return;
      }
      for (const file of files) {
        if (!file.name.toLowerCase().endsWith(".xml")) {
          console.warn("Archivo sin extensión .xml:", file.name);
        }
        try {
          const text = await file.text();
          const fac = parseXML(text, file.name);
          const existing = facturas.findIndex((f) => f.fileName === file.name);
          if (existing >= 0) facturas[existing] = fac;
          else facturas.push(fac);
        } catch (e) {
          pushError(`<strong>${file.name}</strong>: ${(e as Error).message}`);
        }
      }
      render();
      refreshAvatarPreview();
    }

    dropInput?.addEventListener("change", () => {
      if (dropInput.files && dropInput.files.length) handleFiles(dropInput.files);
      dropInput.value = "";
    });

    dropZone?.addEventListener("dropzone:files", ((e: CustomEvent) => {
      if (e.detail?.files) handleFiles(e.detail.files);
    }) as EventListener);

    formatoSel?.addEventListener("change", render);

    btnLimpiar?.addEventListener("click", () => {
      facturas = [];
      if (erroresEl) { erroresEl.innerHTML = ""; erroresEl.style.display = "none"; }
      render();
    });

    btnTodos?.addEventListener("click", async () => {
      if (facturas.length === 0) return;
      const fmt = formatoSel.value;
      await getPdfMake();
      let i = 0;
      const next = () => {
        if (i >= facturas.length) return;
        downloadFactura(facturas[i], fmt);
        i++;
        setTimeout(next, 600);
      };
      next();
    });

    // Init branding + país después de DOM ready
    initBrandingUI();
    initCountrySwitch();

    // Responsive palette grid: 2 cols mobile, 3 cols >640px
    const style = document.createElement("style");
    style.textContent = "@media(min-width:640px){#palette-grid{grid-template-columns:repeat(3,1fr)!important;}#icon-options{grid-template-columns:repeat(3,1fr)!important;}}";
    document.head.appendChild(style);
  </script>
</Layout>
