  <!-- Client-side logic -->
  <script>
    // Lazy-load pdfmake para no inflar el bundle inicial (1.8MB) — se carga solo al descargar
    let _pdfMake: any = null;
    async function getPdfMake(): Promise<any> {
      if (_pdfMake) return _pdfMake;
      const pdfMakeModule: any = await import("pdfmake/build/pdfmake");
      const pdfFonts: any = await import("pdfmake/build/vfs_fonts");
      const pdfMake = pdfMakeModule.default ?? pdfMakeModule.pdfMake ?? pdfMakeModule;
      if (pdfFonts?.pdfMake?.vfs) pdfMake.vfs = pdfFonts.pdfMake.vfs;
      else if (pdfFonts?.vfs) pdfMake.vfs = pdfFonts.vfs;
      else if (pdfFonts?.default?.pdfMake?.vfs) pdfMake.vfs = pdfFonts.default.pdfMake.vfs;
      // Registra aliases de fuentes para pdfmake (todas apuntan a Roboto del vfs)
      const alias = {
        normal: "Roboto-Regular.ttf",
        bold: "Roboto-Medium.ttf",
        italics: "Roboto-Italic.ttf",
        bolditalics: "Roboto-MediumItalic.ttf",
      };
      pdfMake.fonts = {
        Roboto: alias,
        Helvetica: alias,
        Courier: alias,
        Times: alias,
        OpenSans: alias,
      };
      _pdfMake = pdfMake;
      return pdfMake;
    }

    import { COUNTRY_CONFIGS, parseFactura, detectCountry, getCountryConfig, formatMoneyForCountry } from "../lib/xmlParser";
    import type { CountryId, CountryConfig, Factura, Item } from "../lib/xmlParser";

    type Palette = { id: string; label: string; primary: string; accent: string };
    const PALETTES: Palette[] = [
      { id: "azul", label: "Corporativo Azul", primary: "#1e3a8a", accent: "#3b82f6" },
      { id: "mono", label: "Monocromático", primary: "#18181b", accent: "#52525b" },
      { id: "esmeralda", label: "Verde Esmeralda", primary: "#065f46", accent: "#10b981" },
      { id: "tinto", label: "Tinto Elegante", primary: "#881337", accent: "#f43f5e" },
      { id: "purpura", label: "Púrpura Moderno", primary: "#581c87", accent: "#a855f7" },
    ];

    type Branding = {
      paletteId: string;
      font: string;
      businessName: string;
      iconMode: "none" | "avatar" | "upload";
      logoBase64: string | null;
      logoName?: string;
    };

    let branding: Branding = {
      paletteId: "azul",
      font: "Roboto",
      businessName: "",
      iconMode: "none",
      logoBase64: null,
    };

    // Load from localStorage if available
    try {
      const saved = localStorage.getItem("fc_branding");
      if (saved) {
        const parsed = JSON.parse(saved);
        branding = { ...branding, ...parsed, logoBase64: null }; // no persist image for privacy/size
      }
    } catch {}

    function saveBranding() {
      try {
        const toSave = { ...branding, logoBase64: null, logoName: undefined };
        localStorage.setItem("fc_branding", JSON.stringify(toSave));
      } catch {}
    }

    function getPalette(): Palette {
      return PALETTES.find((p) => p.id === branding.paletteId) ?? PALETTES[0];
    }

    function getInitials(name: string): string {
      const clean = name.trim().replace(/\s+/g, " ");
      if (!clean) return "FC";
      const parts = clean.split(" ").filter(Boolean);
      if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
      return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    }

    function generateAvatarBase64(name: string, primary: string): string {
      const canvas = document.getElementById("avatar-canvas") as HTMLCanvasElement | null;
      if (!canvas) return "";
      const ctx = canvas.getContext("2d");
      if (!ctx) return "";
      const size = 200;
      canvas.width = size;
      canvas.height = size;
      // rounded rect background
      ctx.clearRect(0, 0, size, size);
      // background
      ctx.fillStyle = primary;
      const r = 32;
      ctx.beginPath();
      // @ts-ignore roundRect
      if (ctx.roundRect) ctx.roundRect(0, 0, size, size, r);
      else {
        ctx.moveTo(r, 0);
        ctx.lineTo(size - r, 0);
        ctx.quadraticCurveTo(size, 0, size, r);
        ctx.lineTo(size, size - r);
        ctx.quadraticCurveTo(size, size, size - r, size);
        ctx.lineTo(r, size);
        ctx.quadraticCurveTo(0, size, 0, size - r);
        ctx.lineTo(0, r);
        ctx.quadraticCurveTo(0, 0, r, 0);
      }
      ctx.fill();
      // initials
      const initials = getInitials(name || branding.businessName || "Mi Negocio");
      ctx.fillStyle = "#ffffff";
      ctx.font = "bold 80px 'Space Grotesk', sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(initials, size / 2, size / 2 + 4);
      return canvas.toDataURL("image/png");
    }

    function updateBrandingPreview() {
      const pal = getPalette();
      const dot = document.getElementById("branding-preview-dot") as HTMLElement | null;
      const text = document.getElementById("branding-preview-text") as HTMLElement | null;
      const fontEl = document.getElementById("branding-preview-font") as HTMLElement | null;
      if (dot) dot.style.background = pal.primary;
      if (text) {
        const name = branding.businessName?.trim() || "(usa nombre del XML)";
        const icon = branding.iconMode === "none" ? "🚫" : branding.iconMode === "avatar" ? "🔤" : "🖼️";
        text.textContent = `${icon} ${name} · ${pal.label}`;
      }
      if (fontEl) fontEl.textContent = branding.font;
    }

    function refreshAvatarPreview() {
      const wrap = document.getElementById("avatar-preview-wrap") as HTMLElement | null;
      const label = document.getElementById("avatar-initials-label") as HTMLElement | null;
      if (branding.iconMode !== "avatar") {
        if (wrap) wrap.style.display = "none";
        return;
      }
      if (wrap) wrap.style.display = "flex";
      const pal = getPalette();
      const nameForAvatar = branding.businessName?.trim() || (facturas[0]?.emisorNombre ?? "Mi Negocio");
      const initials = getInitials(nameForAvatar);
      if (label) label.textContent = `${initials} · ${nameForAvatar.slice(0, 28)} · ${pal.primary}`;
      const b64 = generateAvatarBase64(nameForAvatar, pal.primary);
      // keep for PDF: regenerate at download time to ensure latest name
      branding.logoBase64 = b64;
    }

    // --- Branding UI wiring ---
    function initBrandingUI() {
      const grid = document.getElementById("palette-grid") as HTMLElement | null;
      const fontSel = document.getElementById("branding-font") as HTMLSelectElement | null;
      const nameInput = document.getElementById("branding-name") as HTMLInputElement | null;
      const iconRadios = document.querySelectorAll<HTMLInputElement>('input[name="branding-icon"]');
      const uploadWrap = document.getElementById("upload-wrap") as HTMLElement | null;
      const uploadInput = document.getElementById("branding-logo-input") as HTMLInputElement | null;
      const uploadPreviewWrap = document.getElementById("upload-preview-wrap") as HTMLElement | null;
      const uploadPreview = document.getElementById("upload-preview") as HTMLImageElement | null;
      const uploadName = document.getElementById("upload-name") as HTMLElement | null;
      const btnRemoveLogo = document.getElementById("btn-remove-logo") as HTMLButtonElement | null;

      if (grid) {
        grid.innerHTML = PALETTES.map(
          (p) => `
          <button
            type="button"
            data-palette="${p.id}"
            aria-pressed="${branding.paletteId === p.id ? "true" : "false"}"
            style="display:flex;align-items:center;gap:0.6rem;padding:0.6rem 0.75rem;min-height:48px;background:var(--surface);border:2px solid ${branding.paletteId === p.id ? p.primary : "var(--border)"};border-radius:12px;box-shadow:${branding.paletteId === p.id ? `3px 3px 0 ${p.primary}` : "3px 3px 0 var(--border)"};cursor:pointer;text-align:left;transition:transform 0.08s;"
          >
            <span style="display:flex;gap:4px;align-items:center;">
              <span style="width:18px;height:18px;border-radius:999px;background:${p.primary};border:2px solid var(--border);display:inline-block;"></span>
              <span style="width:18px;height:18px;border-radius:999px;background:${p.accent};border:2px solid var(--border);display:inline-block;"></span>
            </span>
            <span style="font-weight:800;font-size:0.82rem;line-height:1;">${p.label}</span>
            ${branding.paletteId === p.id ? `<span style="margin-left:auto;font-size:0.9rem;">✓</span>` : ""}
          </button>
        `
        ).join("");

        grid.querySelectorAll<HTMLButtonElement>("button[data-palette]").forEach((btn) => {
          btn.addEventListener("click", () => {
            branding.paletteId = btn.getAttribute("data-palette") as string;
            saveBranding();
            initBrandingUI(); // re-render to update pressed state
            refreshAvatarPreview();
            updateBrandingPreview();
            render();
          });
        });
      }

      if (fontSel) {
        fontSel.value = branding.font;
        fontSel.onchange = () => {
          branding.font = fontSel.value;
          saveBranding();
          updateBrandingPreview();
        };
      }

      if (nameInput) {
        nameInput.value = branding.businessName;
        nameInput.oninput = () => {
          branding.businessName = nameInput.value;
          saveBranding();
          updateBrandingPreview();
          refreshAvatarPreview();
          render();
        };
      }

      iconRadios.forEach((r) => {
        r.checked = r.value === branding.iconMode;
        r.addEventListener("change", () => {
          if (!r.checked) return;
          branding.iconMode = r.value as Branding["iconMode"];
          if (branding.iconMode !== "upload") {
            // clear upload if switching away? keep but hide
          }
          if (branding.iconMode === "avatar") {
            branding.logoBase64 = null; // will be regenerated
          } else if (branding.iconMode === "none") {
            branding.logoBase64 = null;
          }
          saveBranding();
          syncIconVisibility();
          refreshAvatarPreview();
          updateBrandingPreview();
        });
      });

      function syncIconVisibility() {
        const avatarWrap = document.getElementById("avatar-preview-wrap") as HTMLElement | null;
        if (uploadWrap) uploadWrap.style.display = branding.iconMode === "upload" ? "grid" : "none";
        if (avatarWrap) avatarWrap.style.display = branding.iconMode === "avatar" ? "flex" : "none";
        if (branding.iconMode === "avatar") refreshAvatarPreview();
        if (branding.iconMode === "upload" && branding.logoBase64 && uploadPreview && uploadPreviewWrap && uploadName) {
          uploadPreview.src = branding.logoBase64;
          uploadPreviewWrap.style.display = "flex";
          uploadName.textContent = branding.logoName ?? "logo";
        }
      }
      syncIconVisibility();

      uploadInput?.addEventListener("change", () => {
        const file = uploadInput.files?.[0];
        if (!file) return;
        if (file.size > 800 * 1024) {
          pushError("Imagen demasiado grande. Máximo 800KB. Comprime el PNG/JPG e intenta de nuevo.");
          uploadInput.value = "";
          return;
        }
        if (!file.type.startsWith("image/")) {
          pushError("Archivo no es una imagen PNG/JPG.");
          return;
        }
        const reader = new FileReader();
        reader.onload = () => {
          const b64 = reader.result as string;
          branding.logoBase64 = b64;
          branding.logoName = file.name;
          saveBranding();
          if (uploadPreview) uploadPreview.src = b64;
          if (uploadPreviewWrap) uploadPreviewWrap.style.display = "flex";
          if (uploadName) uploadName.textContent = file.name;
          updateBrandingPreview();
        };
        reader.onerror = () => pushError("No se pudo leer la imagen.");
        reader.readAsDataURL(file);
        // reset so same file can be re-selected
        uploadInput.value = "";
      });

      btnRemoveLogo?.addEventListener("click", () => {
        branding.logoBase64 = null;
        branding.logoName = undefined;
        if (uploadPreviewWrap) uploadPreviewWrap.style.display = "none";
        if (uploadPreview) uploadPreview.removeAttribute("src");
        if (uploadName) uploadName.textContent = "";
        updateBrandingPreview();
      });

      updateBrandingPreview();
      refreshAvatarPreview();
    }

    const $ = (s: string) => document.querySelector(s) as HTMLElement | null;
    const lista = $("#lista") as HTMLElement;
    const erroresEl = $("#errores") as HTMLElement;
    const emptyEl = $("#empty") as HTMLElement;
    const controlsEl = $("#controls") as HTMLElement;
    const resumenEl = $("#resumen") as HTMLElement;
    const formatoSel = $("#formato") as HTMLSelectElement;
    const btnTodos = $("#btn-descargar-todos") as HTMLButtonElement;
    const btnLimpiar = $("#btn-limpiar") as HTMLButtonElement;
    const dropInput = document.getElementById("xml-dropzone-input") as HTMLInputElement | null;
    const dropZone = document.getElementById("xml-dropzone") as HTMLElement | null;

    let facturas: Factura[] = [];

    // ——— Multi-país: selector y parser universal ———
    let selectedCountry: CountryId = ((): CountryId => {
      try {
        const s = localStorage.getItem('fc_country') as CountryId | null;
        if (s && (s in COUNTRY_CONFIGS)) return s;
      } catch {}
      return 'gt';
    })();

