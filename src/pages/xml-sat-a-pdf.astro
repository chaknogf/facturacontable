      const badges = document.getElementById('hero-badges');
      const badgeMoneda = document.getElementById('badge-moneda');
      const badgeImpuesto = document.getElementById('badge-impuesto');
      const heroPais = document.getElementById('hero-pais-label');
      const hint = document.getElementById('country-auto-hint');
      if(badgeMoneda) badgeMoneda.textContent = `${cfg.currency} · ${cfg.currencyCode} · ${cfg.idLabel}`;
      if(badgeImpuesto) badgeImpuesto.textContent = cfg.taxLabel;
      if(heroPais) heroPais.textContent = `${cfg.flag} ${cfg.label} · ${COUNTRY_CONFIGS.gt.flag} ${COUNTRY_CONFIGS.mx.flag} ${COUNTRY_CONFIGS.co.flag} ${COUNTRY_CONFIGS.pe.flag} ${COUNTRY_CONFIGS.ec.flag}`;
      if(hint) hint.textContent = `${cfg.flag} ${cfg.shortLabel} · ${cfg.ente} · Auto-detecta`;
