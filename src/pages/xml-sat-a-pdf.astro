  <!-- Client-side logic -->
  <script>
    // Lazy-load pdfmake para no inflar el bundle inicial (1.8MB) — se carga solo al descargar
    let _pdfMake: any = null;
    async function getPdfMake(): Promise<any> {
      if (_pdfMake) return _pdfMake;
      const pdfMakeModule: any = await import("pdfmake/build/pdfmake");
      const pdfFonts: any = await import("pdfmake/build/vfs_fonts");
      const pdfMake = pdfMakeModule.default ?? pdfMakeModule.pdfMake ?? pdfMakeModule;
      if (pdfFonts?.pdfMake?.vfs) pdfMake.vfs = pdfFonts.pdfMake.vfs;
      else if (pdfFonts?.vfs) pdfMake.vfs = pdfFonts.vfs;
      else if (pdfFonts?.default?.pdfMake?.vfs) pdfMake.vfs = pdfFonts.default.pdfMake.vfs;
      // Registra aliases de fuentes para pdfmake (todas apuntan a Roboto del vfs)
      const alias = {
        normal: "Roboto-Regular.ttf",
        bold: "Roboto-Medium.ttf",
        italics: "Roboto-Italic.ttf",
        bolditalics: "Roboto-MediumItalic.ttf",
      };
      pdfMake.fonts = {
        Roboto: alias,
        Helvetica: alias,
        Courier: alias,
        Times: alias,
        OpenSans: alias,
      };
      _pdfMake = pdfMake;
      return pdfMake;
    }

    type Item = { descripcion: string; cantidad: string; precio: string; total: string; unidad?: string };
    type Factura = {
      fileName: string;
      numeroAcceso?: string;
      serie?: string;
      numero?: string;
      fechaEmision?: string;
      emisorNombre?: string;
      emisorNIT?: string;
      emisorDireccion?: string;
      receptorNombre?: string;
      receptorNIT?: string;
      receptorDireccion?: string;
      moneda?: string;
      granTotal?: string;
      iva?: string;
      items: Item[];
      rawXml?: string;
    };

    type Palette = { id: string; label: string; primary: string; accent: string };
    const PALETTES: Palette[] = [
      { id: "azul", label: "Corporativo Azul", primary: "#1e3a8a", accent: "#3b82f6" },
      { id: "mono", label: "Monocromático", primary: "#18181b", accent: "#52525b" },
      { id: "esmeralda", label: "Verde Esmeralda", primary: "#065f46", accent: "#10b981" },
      { id: "tinto", label: "Tinto Elegante", primary: "#881337", accent: "#f43f5e" },
      { id: "purpura", label: "Púrpura Moderno", primary: "#581c87", accent: "#a855f7" },
    ];

    type Branding = {
      paletteId: string;
      font: string;
      businessName: string;
      iconMode: "none" | "avatar" | "upload";
      logoBase64: string | null;
      logoName?: string;
    };

    let branding: Branding = {
      paletteId: "azul",
      font: "Roboto",
      businessName: "",
      iconMode: "none",
      logoBase64: null,
    };

    // Load from localStorage if available
    try {
      const saved = localStorage.getItem("fc_branding");
      if (saved) {
        const parsed = JSON.parse(saved);
        branding = { ...branding, ...parsed, logoBase64: null }; // no persist image for privacy/size
      }
    } catch {}

    function saveBranding() {
      try {
        const toSave = { ...branding, logoBase64: null, logoName: undefined };
        localStorage.setItem("fc_branding", JSON.stringify(toSave));
      } catch {}
    }

    function getPalette(): Palette {
      return PALETTES.find((p) => p.id === branding.paletteId) ?? PALETTES[0];
    }

    function getInitials(name: string): string {
      const clean = name.trim().replace(/\s+/g, " ");
      if (!clean) return "FC";
      const parts = clean.split(" ").filter(Boolean);
      if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
      return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    }

    function generateAvatarBase64(name: string, primary: string): string {
      const canvas = document.getElementById("avatar-canvas") as HTMLCanvasElement | null;
      if (!canvas) return "";
      const ctx = canvas.getContext("2d");
      if (!ctx) return "";
      const size = 200;
      canvas.width = size;
      canvas.height = size;
      // rounded rect background
      ctx.clearRect(0, 0, size, size);
      // background
      ctx.fillStyle = primary;
      const r = 32;
      ctx.beginPath();
      // @ts-ignore roundRect
      if (ctx.roundRect) ctx.roundRect(0, 0, size, size, r);
      else {
        ctx.moveTo(r, 0);
        ctx.lineTo(size - r, 0);
        ctx.quadraticCurveTo(size, 0, size, r);
        ctx.lineTo(size, size - r);
        ctx.quadraticCurveTo(size, size, size - r, size);
        ctx.lineTo(r, size);
        ctx.quadraticCurveTo(0, size, 0, size - r);
        ctx.lineTo(0, r);
        ctx.quadraticCurveTo(0, 0, r, 0);
      }
      ctx.fill();
      // initials
      const initials = getInitials(name || branding.businessName || "Mi Negocio");
      ctx.fillStyle = "#ffffff";
      ctx.font = "bold 80px 'Space Grotesk', sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(initials, size / 2, size / 2 + 4);
      return canvas.toDataURL("image/png");
    }

    function updateBrandingPreview() {
      const pal = getPalette();
      const dot = document.getElementById("branding-preview-dot") as HTMLElement | null;
      const text = document.getElementById("branding-preview-text") as HTMLElement | null;
      const fontEl = document.getElementById("branding-preview-font") as HTMLElement | null;
      if (dot) dot.style.background = pal.primary;
      if (text) {
        const name = branding.businessName?.trim() || "(usa nombre del XML)";
        const icon = branding.iconMode === "none" ? "🚫" : branding.iconMode === "avatar" ? "🔤" : "🖼️";
        text.textContent = `${icon} ${name} · ${pal.label}`;
      }
      if (fontEl) fontEl.textContent = branding.font;
    }

    function refreshAvatarPreview() {
      const wrap = document.getElementById("avatar-preview-wrap") as HTMLElement | null;
      const label = document.getElementById("avatar-initials-label") as HTMLElement | null;
      if (branding.iconMode !== "avatar") {
        if (wrap) wrap.style.display = "none";
        return;
      }
      if (wrap) wrap.style.display = "flex";
      const pal = getPalette();
      const nameForAvatar = branding.businessName?.trim() || (facturas[0]?.emisorNombre ?? "Mi Negocio");
      const initials = getInitials(nameForAvatar);
      if (label) label.textContent = `${initials} · ${nameForAvatar.slice(0, 28)} · ${pal.primary}`;
      const b64 = generateAvatarBase64(nameForAvatar, pal.primary);
      // keep for PDF: regenerate at download time to ensure latest name
      branding.logoBase64 = b64;
    }

    // --- Branding UI wiring ---
    function initBrandingUI() {
      const grid = document.getElementById("palette-grid") as HTMLElement | null;
      const fontSel = document.getElementById("branding-font") as HTMLSelectElement | null;
      const nameInput = document.getElementById("branding-name") as HTMLInputElement | null;
      const iconRadios = document.querySelectorAll<HTMLInputElement>('input[name="branding-icon"]');
      const uploadWrap = document.getElementById("upload-wrap") as HTMLElement | null;
      const uploadInput = document.getElementById("branding-logo-input") as HTMLInputElement | null;
      const uploadPreviewWrap = document.getElementById("upload-preview-wrap") as HTMLElement | null;
      const uploadPreview = document.getElementById("upload-preview") as HTMLImageElement | null;
      const uploadName = document.getElementById("upload-name") as HTMLElement | null;
      const btnRemoveLogo = document.getElementById("btn-remove-logo") as HTMLButtonElement | null;

      if (grid) {
        grid.innerHTML = PALETTES.map(
          (p) => `
          <button
            type="button"
            data-palette="${p.id}"
            aria-pressed="${branding.paletteId === p.id ? "true" : "false"}"
            style="display:flex;align-items:center;gap:0.6rem;padding:0.6rem 0.75rem;min-height:48px;background:var(--surface);border:2px solid ${branding.paletteId === p.id ? p.primary : "var(--border)"};border-radius:12px;box-shadow:${branding.paletteId === p.id ? `3px 3px 0 ${p.primary}` : "3px 3px 0 var(--border)"};cursor:pointer;text-align:left;transition:transform 0.08s;"
          >
            <span style="display:flex;gap:4px;align-items:center;">
              <span style="width:18px;height:18px;border-radius:999px;background:${p.primary};border:2px solid var(--border);display:inline-block;"></span>
              <span style="width:18px;height:18px;border-radius:999px;background:${p.accent};border:2px solid var(--border);display:inline-block;"></span>
            </span>
            <span style="font-weight:800;font-size:0.82rem;line-height:1;">${p.label}</span>
            ${branding.paletteId === p.id ? `<span style="margin-left:auto;font-size:0.9rem;">✓</span>` : ""}
          </button>
        `
        ).join("");

        grid.querySelectorAll<HTMLButtonElement>("button[data-palette]").forEach((btn) => {
          btn.addEventListener("click", () => {
            branding.paletteId = btn.getAttribute("data-palette") as string;
            saveBranding();
            initBrandingUI(); // re-render to update pressed state
            refreshAvatarPreview();
            updateBrandingPreview();
            render();
          });
        });
      }

      if (fontSel) {
        fontSel.value = branding.font;
        fontSel.onchange = () => {
          branding.font = fontSel.value;
          saveBranding();
          updateBrandingPreview();
        };
      }

      if (nameInput) {
        nameInput.value = branding.businessName;
        nameInput.oninput = () => {
          branding.businessName = nameInput.value;
          saveBranding();
          updateBrandingPreview();
          refreshAvatarPreview();
          render();
        };
      }

      iconRadios.forEach((r) => {
        r.checked = r.value === branding.iconMode;
        r.addEventListener("change", () => {
          if (!r.checked) return;
          branding.iconMode = r.value as Branding["iconMode"];
          if (branding.iconMode !== "upload") {
            // clear upload if switching away? keep but hide
          }
          if (branding.iconMode === "avatar") {
            branding.logoBase64 = null; // will be regenerated
          } else if (branding.iconMode === "none") {
            branding.logoBase64 = null;
          }
          saveBranding();
          syncIconVisibility();
          refreshAvatarPreview();
          updateBrandingPreview();
        });
      });

      function syncIconVisibility() {
        const avatarWrap = document.getElementById("avatar-preview-wrap") as HTMLElement | null;
        if (uploadWrap) uploadWrap.style.display = branding.iconMode === "upload" ? "grid" : "none";
        if (avatarWrap) avatarWrap.style.display = branding.iconMode === "avatar" ? "flex" : "none";
        if (branding.iconMode === "avatar") refreshAvatarPreview();
        if (branding.iconMode === "upload" && branding.logoBase64 && uploadPreview && uploadPreviewWrap && uploadName) {
          uploadPreview.src = branding.logoBase64;
          uploadPreviewWrap.style.display = "flex";
          uploadName.textContent = branding.logoName ?? "logo";
        }
      }
      syncIconVisibility();

      uploadInput?.addEventListener("change", () => {
        const file = uploadInput.files?.[0];
        if (!file) return;
        if (file.size > 800 * 1024) {
          pushError("Imagen demasiado grande. Máximo 800KB. Comprime el PNG/JPG e intenta de nuevo.");
          uploadInput.value = "";
          return;
        }
        if (!file.type.startsWith("image/")) {
          pushError("Archivo no es una imagen PNG/JPG.");
          return;
        }
        const reader = new FileReader();
        reader.onload = () => {
          const b64 = reader.result as string;
          branding.logoBase64 = b64;
          branding.logoName = file.name;
          saveBranding();
          if (uploadPreview) uploadPreview.src = b64;
          if (uploadPreviewWrap) uploadPreviewWrap.style.display = "flex";
          if (uploadName) uploadName.textContent = file.name;
          updateBrandingPreview();
        };
        reader.onerror = () => pushError("No se pudo leer la imagen.");
        reader.readAsDataURL(file);
        // reset so same file can be re-selected
        uploadInput.value = "";
      });

      btnRemoveLogo?.addEventListener("click", () => {
        branding.logoBase64 = null;
        branding.logoName = undefined;
        if (uploadPreviewWrap) uploadPreviewWrap.style.display = "none";
        if (uploadPreview) uploadPreview.removeAttribute("src");
        if (uploadName) uploadName.textContent = "";
        updateBrandingPreview();
      });

      updateBrandingPreview();
      refreshAvatarPreview();
    }

    const $ = (s: string) => document.querySelector(s) as HTMLElement | null;
    const lista = $("#lista") as HTMLElement;
    const erroresEl = $("#errores") as HTMLElement;
    const emptyEl = $("#empty") as HTMLElement;
    const controlsEl = $("#controls") as HTMLElement;
    const resumenEl = $("#resumen") as HTMLElement;
    const formatoSel = $("#formato") as HTMLSelectElement;
    const btnTodos = $("#btn-descargar-todos") as HTMLButtonElement;
    const btnLimpiar = $("#btn-limpiar") as HTMLButtonElement;
    const dropInput = document.getElementById("xml-dropzone-input") as HTMLInputElement | null;
    const dropZone = document.getElementById("xml-dropzone") as HTMLElement | null;

    let facturas: Factura[] = [];

    function textByTag(xmlDoc: Document, localName: string): string | undefined {
      const els = xmlDoc.getElementsByTagNameNS("*", localName);
      if (els.length > 0) return els[0].textContent?.trim() || undefined;
      const els2 = xmlDoc.getElementsByTagName(localName);
      if (els2.length > 0) return els2[0].textContent?.trim() || undefined;
      return undefined;
    }

    function attrByTag(xmlDoc: Document, localName: string, attr: string): string | undefined {
      const els = xmlDoc.getElementsByTagNameNS("*", localName);
      if (els.length > 0) return els[0].getAttribute(attr) ?? undefined;
      const els2 = xmlDoc.getElementsByTagName(localName);
      if (els2.length > 0) return els2[0].getAttribute(attr) ?? undefined;
      return undefined;
    }

    function parseXML(text: string, fileName: string): Factura {
      const parser = new DOMParser();
      const doc = parser.parseFromString(text, "application/xml");
      const parseErr = doc.querySelector("parsererror");
      if (parseErr) throw new Error("XML inválido: " + (parseErr.textContent?.slice(0, 200) ?? ""));

      const hasGTDoc = doc.getElementsByTagNameNS("*", "GTDocumento").length > 0
        || doc.getElementsByTagName("GTDocumento").length > 0
        || text.includes("GTDocumento");

      if (!hasGTDoc && !text.includes("DatosGenerales") && !text.includes("Emisor")) {
        console.warn("XML no parece FEL SAT:", fileName);
      }

      const datosGenerales = doc.getElementsByTagNameNS("*", "DatosGenerales")[0]
        ?? doc.getElementsByTagName("DatosGenerales")[0];
      const emisorEl = doc.getElementsByTagNameNS("*", "Emisor")[0] ?? doc.getElementsByTagName("Emisor")[0];
      const receptorEl = doc.getElementsByTagNameNS("*", "Receptor")[0] ?? doc.getElementsByTagName("Receptor")[0];
      const totalesEl = doc.getElementsByTagNameNS("*", "Totales")[0] ?? doc.getElementsByTagName("Totales")[0];

      const getAttr = (el: Element | undefined, name: string) => el?.getAttribute(name) ?? undefined;

      const granTotal = getAttr(totalesEl as Element, "GranTotal")
        ?? attrByTag(doc, "Totales", "GranTotal")
        ?? textByTag(doc, "GranTotal");

      const itemNodes = doc.getElementsByTagNameNS("*", "Item");
      const fallbackItems = itemNodes.length === 0 ? doc.getElementsByTagName("Item") : itemNodes;
      const items: Item[] = [];
      for (let i = 0; i < fallbackItems.length; i++) {
        const it = fallbackItems[i] as Element;
        const desc = it.getAttribute("Descripcion") ?? it.getAttribute("descripcion") ?? it.textContent?.trim().slice(0, 80) ?? `Item ${i + 1}`;
        const cantidad = it.getAttribute("Cantidad") ?? it.getAttribute("cantidad") ?? "1";
        const precio = it.getAttribute("Precio") ?? it.getAttribute("precio") ?? it.getAttribute("PrecioUnitario") ?? "";
        const total = it.getAttribute("Total") ?? it.getAttribute("total") ?? precio;
        const unidad = it.getAttribute("UnidadMedida") ?? it.getAttribute("BienOServicio") ?? undefined;
        if (!desc && !precio && !total) continue;
        items.push({ descripcion: desc, cantidad, precio, total, unidad });
      }

      if (items.length === 0) {
        const detNodes = doc.getElementsByTagNameNS("*", "Detalle");
        const dets = detNodes.length ? detNodes : doc.getElementsByTagName("Detalle");
        for (let i = 0; i < dets.length; i++) {
          const d = dets[i] as Element;
          const txt = d.textContent?.trim();
          if (txt) items.push({ descripcion: txt.slice(0, 100), cantidad: "1", precio: "", total: "" });
        }
      }

      const emisorNombre = getAttr(emisorEl as Element, "NombreComercial")
        ?? getAttr(emisorEl as Element, "Nombre")
        ?? emisorEl?.getAttribute("NITEmisor") ? undefined : textByTag(doc, "NombreComercial");
      const emisorNIT = getAttr(emisorEl as Element, "NITEmisor")
        ?? getAttr(emisorEl as Element, "NIT")
        ?? attrByTag(doc, "Emisor", "NITEmisor");
      const receptorNombre = getAttr(receptorEl as Element, "NombreReceptor")
        ?? getAttr(receptorEl as Element, "Nombre")
        ?? attrByTag(doc, "Receptor", "NombreReceptor");
      const receptorNIT = getAttr(receptorEl as Element, "IDReceptor")
        ?? getAttr(receptorEl as Element, "NITReceptor")
        ?? getAttr(receptorEl as Element, "NIT")
        ?? attrByTag(doc, "Receptor", "IDReceptor");

      const factura: Factura = {
        fileName,
        numeroAcceso: getAttr(datosGenerales as Element, "NumeroAcceso")
          ?? attrByTag(doc, "DatosGenerales", "NumeroAcceso"),
        serie: getAttr(datosGenerales as Element, "Serie")
          ?? attrByTag(doc, "DatosGenerales", "Serie"),
        numero: getAttr(datosGenerales as Element, "Numero")
          ?? attrByTag(doc, "DatosGenerales", "Numero"),
        fechaEmision: getAttr(datosGenerales as Element, "FechaHoraEmision")
          ?? attrByTag(doc, "DatosGenerales", "FechaHoraEmision"),
        emisorNombre: emisorNombre ?? getAttr(emisorEl as Element, "NombreEmisor") ?? "—",
        emisorNIT: emisorNIT ?? "—",
        emisorDireccion: getAttr(emisorEl as Element, "Direccion") ?? textByTag(doc, "Direccion"),
        receptorNombre: receptorNombre ?? "—",
        receptorNIT: receptorNIT ?? "—",
        receptorDireccion: getAttr(receptorEl as Element, "Direccion"),
        moneda: getAttr(datosGenerales as Element, "CodigoMoneda")
          ?? getAttr(datosGenerales as Element, "Moneda")
          ?? "GTQ",
        granTotal: granTotal ?? "—",
        iva: getAttr(totalesEl as Element, "TotalImpuestos")
          ?? attrByTag(doc, "Totales", "TotalImpuestos"),
        items: items.length ? items : [{ descripcion: "Detalle no desglosado en XML", cantidad: "1", precio: granTotal ?? "", total: granTotal ?? "" }],
        rawXml: text.slice(0, 4000),
      };

      return factura;
    }

    function formatMoney(v: string | undefined, moneda = "GTQ"): string {
      if (!v || v === "—") return "—";
      const n = Number(String(v).replace(",", "."));
      if (isNaN(n)) return String(v);
      return new Intl.NumberFormat("es-GT", { style: "currency", currency: "GTQ", minimumFractionDigits: 2 }).format(n);
    }

    function getBrandingForPdf(f: Factura): { palette: Palette; font: string; displayName: string; logoBase64: string | null } {
      const palette = getPalette();
      const displayName = branding.businessName?.trim() || f.emisorNombre || "—";
      let logoBase64: string | null = null;
      if (branding.iconMode === "upload") {
        logoBase64 = branding.logoBase64;
      } else if (branding.iconMode === "avatar") {
        // regenerate on the fly to pick latest name/palette
        logoBase64 = generateAvatarBase64(displayName, palette.primary);
      }
      return { palette, font: branding.font, displayName, logoBase64 };
    }

    function buildDocDefinition(f: Factura, formato: string): any {
      const { palette, font, displayName, logoBase64 } = getBrandingForPdf(f);
      const moneda = f.moneda ?? "GTQ";
      const isTicket = formato === "ticket";
      const titulo = isTicket ? "DTE — FEL" : "Documento Tributario Electrónico — FEL";

      // Header with logo/avatar if present
      const headerBranding: any[] = [];
      if (logoBase64) {
        headerBranding.push({
          columns: [
            {
              image: logoBase64,
              width: isTicket ? 36 : 48,
              height: isTicket ? 36 : 48,
              margin: [0, 0, 8, 6],
            },
            {
              width: "*",
              stack: [
                { text: displayName, fontSize: isTicket ? 9 : 11, bold: true, color: palette.primary, margin: [0, isTicket ? 2 : 4, 0, 2] },
                { text: `NIT: ${f.emisorNIT ?? "—"}`, fontSize: 7, color: "#444" },
                ...(f.emisorDireccion && !isTicket ? [{ text: f.emisorDireccion, fontSize: 7, color: "#444" }] : []),
              ],
            },
          ],
          columnGap: 6,
          margin: [0, 0, 0, 6],
        });
      } else {
        headerBranding.push({
          text: displayName,
          fontSize: isTicket ? 10 : 12,
          bold: true,
          color: palette.primary,
          alignment: isTicket ? "center" : "left",
          margin: [0, 0, 0, 2],
        });
        if (!isTicket) {
          headerBranding.push({
            text: `NIT: ${f.emisorNIT ?? "—"}${f.emisorDireccion ? " · " + f.emisorDireccion : ""}`,
            fontSize: 7,
            color: "#444",
            margin: [0, 0, 0, 6],
          });
        } else {
          headerBranding.push({
            text: `NIT: ${f.emisorNIT ?? "—"}`,
            fontSize: 7,
            color: "#444",
            alignment: "center",
            margin: [0, 0, 0, 6],
          });
        }
      }

      const commonStyles = {
        header: { fontSize: isTicket ? 9 : 13, bold: true, color: palette.primary },
        sub: { fontSize: isTicket ? 7 : 8, color: "#444" },
        tableHeader: { bold: true, fontSize: isTicket ? 7 : 8, color: "white", fillColor: palette.primary },
        total: { bold: true, fontSize: isTicket ? 8 : 10 },
      };

      // === TICKET minimalista: lista limpia ===
      if (isTicket) {
        const ticketItems: any[] = [];
        f.items.forEach((it, idx) => {
          const qty = (it.cantidad ?? "1").toString();
          const desc = it.descripcion || `Item ${idx + 1}`;
          const total = it.total ? formatMoney(it.total, moneda) : it.precio ? formatMoney(it.precio, moneda) : "—";
          ticketItems.push({
            columns: [
              { text: `${qty}x ${desc}`, fontSize: 7, margin: [0, 2, 0, 0], width: "*" },
              { text: total, fontSize: 7, bold: true, alignment: "right", width: 52, margin: [6, 2, 0, 0] },
            ],
            columnGap: 4,
          });
          // dashed separator
          if (idx < f.items.length - 1) {
            ticketItems.push({
              canvas: [{ type: "line", x1: 0, y1: 4, x2: 210, y2: 4, lineWidth: 0.6, dash: { length: 2 }, lineColor: "#bbb" }],
              margin: [0, 0, 0, 0],
            });
          }
        });

        // Total + foot for ticket
        const content: any[] = [
          { text: titulo, style: "header", alignment: "center", margin: [0, 0, 0, 2] },
          {
            text: `SAT Guatemala · FEL · ${f.serie ?? ""} ${f.numero ?? ""}`.trim(),
            style: "sub",
            alignment: "center",
            margin: [0, 0, 0, 6],
          },
          // dashed top
          { canvas: [{ type: "line", x1: 0, y1: 0, x2: 210, y2: 0, lineWidth: 0.7, dash: { length: 3 }, lineColor: palette.accent }], margin: [0, 0, 0, 6] },
          ...headerBranding,
          { canvas: [{ type: "line", x1: 0, y1: 0, x2: 210, y2: 0, lineWidth: 0.5, lineColor: "#ddd" }], margin: [0, 4, 0, 6] },
          // Receptor + fecha compact
          {
            stack: [
              { text: `Cliente: ${f.receptorNombre ?? "—"}`, fontSize: 7, bold: true },
              { text: `NIT/CUI: ${f.receptorNIT ?? "—"}`, fontSize: 6, color: "#555" },
              ...(f.fechaEmision ? [{ text: `Fecha: ${f.fechaEmision.slice(0, 10)}`, fontSize: 6, color: "#555" }] : []),
            ],
            margin: [0, 0, 0, 6],
          },
          { canvas: [{ type: "line", x1: 0, y1: 0, x2: 210, y2: 0, lineWidth: 0.7, dash: { length: 3 }, lineColor: palette.accent }], margin: [0, 0, 0, 6] },
          ...ticketItems,
          { canvas: [{ type: "line", x1: 0, y1: 6, x2: 210, y2: 6, lineWidth: 0.7, dash: { length: 3 }, lineColor: palette.accent }], margin: [0, 0, 0, 6] },
          {
            columns: [
              { text: "TOTAL", fontSize: 8, bold: true, color: palette.primary },
              { text: formatMoney(f.granTotal, moneda), fontSize: 9, bold: true, alignment: "right", color: palette.primary },
            ],
            margin: [0, 2, 0, 0],
          },
          ...(f.iva ? [{ text: `IVA incluido: ${formatMoney(f.iva, moneda)}`, fontSize: 6, color: "#666", alignment: "right", margin: [0, 2, 0, 0] }] : []),
          ...(f.numeroAcceso ? [{ text: `Acceso: ${f.numeroAcceso}`, fontSize: 5, color: "#999", alignment: "center", margin: [0, 8, 0, 0] }] : []),
          {
            text: "XML original es el único comprobante válido ante SAT.",
            fontSize: 5,
            color: "#999",
            alignment: "center",
            margin: [0, 6, 0, 0],
          },
          {
            text: "FacturaContable.gt · 100% navegador · 🇬🇹",
            fontSize: 5,
            color: "#aaa",
            alignment: "center",
            margin: [0, 2, 0, 0],
          },
        ];

        // Alto dinámico: base 220 + 18 por item + logo extra, clamped 320..1200
        const base = 220;
        const perItem = 18;
        const logoExtra = logoBase64 ? 30 : 0;
        const h = Math.min(1200, Math.max(320, base + f.items.length * perItem + logoExtra + (f.numeroAcceso ? 12 : 0)));

        return {
          pageSize: { width: 226.77, height: h },
          pageMargins: [8, 10, 8, 10],
          content,
          styles: commonStyles,
          defaultStyle: { font: font, fontSize: 7, color: "#111" },
        };
      }

      // === CARTA / MEDIA: tabla con branding ===
      const itemsBody: any[] = [
        [
          { text: "#", style: "tableHeader", alignment: "center" },
          { text: "Descripción", style: "tableHeader" },
          { text: "Cant.", style: "tableHeader", alignment: "center" },
          { text: "Precio", style: "tableHeader", alignment: "right" },
          { text: "Total", style: "tableHeader", alignment: "right" },
        ],
        ...f.items.map((it, idx) => [
          { text: String(idx + 1), fontSize: 8, alignment: "center" },
          { text: it.descripcion, fontSize: 8 },
          { text: String(it.cantidad), fontSize: 8, alignment: "center" },
          { text: it.precio ? formatMoney(it.precio, moneda) : "—", fontSize: 8, alignment: "right" },
          { text: it.total ? formatMoney(it.total, moneda) : "—", fontSize: 8, alignment: "right" },
        ]),
      ];

      const isMedia = formato === "media";
      const content: any[] = [
        { text: titulo, style: "header", alignment: "center", margin: [0, 0, 0, 4] },
        {
          text: `SAT Guatemala · FEL · ${f.serie ?? ""} ${f.numero ?? ""} ${f.numeroAcceso ? "· " + f.numeroAcceso.slice(0, 22) + "…" : ""}`.trim(),
          style: "sub",
          alignment: "center",
          margin: [0, 0, 0, 8],
        },
        ...headerBranding,
        {
          columns: [
            {
              width: "*",
              stack: [
                { canvas: [{ type: "line", x1: 0, y1: 0, x2: 80, y2: 0, lineWidth: 2, lineColor: palette.accent }], margin: [0, 0, 0, 4] },
                { text: "RECEPTOR", fontSize: 7, bold: true, color: palette.primary, margin: [0, 0, 0, 2] },
                { text: f.receptorNombre ?? "—", fontSize: 9, bold: true },
                { text: `NIT/CUI: ${f.receptorNIT ?? "—"}`, fontSize: 7, color: "#444" },
                ...(f.receptorDireccion ? [{ text: f.receptorDireccion, fontSize: 7, color: "#444" }] : []),
                ...(f.fechaEmision ? [{ text: `Fecha: ${f.fechaEmision}`, fontSize: 7, color: "#444", margin: [0, 4, 0, 0] }] : []),
                { text: `Moneda: ${moneda}`, fontSize: 7, color: "#444" },
              ],
            },
          ],
          margin: [0, 0, 0, 10],
        },
        {
          table: { headerRows: 1, widths: isMedia ? [18, "*", 30, 50, 50] : [18, "*", 36, 58, 58], body: itemsBody },
          layout: {
            fillColor: (rowIndex: number) => (rowIndex === 0 ? palette.primary : rowIndex % 2 === 0 ? "#F5F0E8" : null),
            hLineWidth: () => 0.5,
            vLineWidth: () => 0.5,
            hLineColor: () => "#111111",
            vLineColor: () => "#111111",
          },
          margin: [0, 0, 0, 8],
        },
        {
          columns: [
            { width: "*", text: "" },
            {
              width: 180,
              stack: [
                {
                  columns: [
                    { text: "Gran Total", fontSize: 8, bold: true, color: palette.primary },
                    { text: formatMoney(f.granTotal, moneda), fontSize: 10, bold: true, alignment: "right", color: palette.primary },
                  ],
                  margin: [0, 0, 0, 2],
                },
                ...(f.iva
                  ? [{ text: `IVA incluido: ${formatMoney(f.iva, moneda)}`, fontSize: 7, color: "#666", alignment: "right" }]
                  : []),
                ...(f.numeroAcceso
                  ? [{ text: `No. Acceso: ${f.numeroAcceso}`, fontSize: 6, color: "#888", alignment: "right", margin: [0, 6, 0, 0] }]
                  : []),
              ],
            },
          ],
        },
        {
          canvas: [{ type: "line", x1: 0, y1: 8, x2: 540, y2: 8, lineWidth: 1, lineColor: palette.accent }],
          margin: [0, 0, 0, 0],
        },
        {
          text: "Documento generado localmente desde el XML original. El XML es el único comprobante con validez tributaria ante la SAT.",
          fontSize: 6,
          color: "#888",
          alignment: "center",
          margin: [0, 8, 0, 0],
        },
        {
          text: "FacturaContable.gt · 100% en tu navegador · Hecho en Guatemala 🇬🇹",
          fontSize: 6,
          color: "#888",
          alignment: "center",
          margin: [0, 2, 0, 0],
        },
      ];

      if (isMedia) {
        return {
          pageSize: "A5",
          pageOrientation: "landscape",
          pageMargins: [18, 16, 18, 16],
          content,
          styles: commonStyles,
          defaultStyle: { font: font, fontSize: 8, color: "#111" },
        };
      }
      return {
        pageSize: "LETTER",
        pageMargins: [28, 22, 28, 22],
        content,
        styles: commonStyles,
        defaultStyle: { font: font, fontSize: 9, color: "#111" },
      };
    }

    async function downloadFactura(f: Factura, formato: string) {
      const docDef = buildDocDefinition(f, formato);
      const base = (f.fileName || "DTE").replace(/\.xml$/i, "");
      const suf = formato === "carta" ? "Carta" : formato === "media" ? "MediaCarta" : "Ticket80mm";
      const outName = `${base}_${suf}.pdf`;
      try {
        const pdfMake = await getPdfMake();
        pdfMake.createPdf(docDef).download(outName);
      } catch (e) {
        console.error(e);
        pushError(`No se pudo generar el PDF para ${f.fileName}: ${(e as Error).message}`);
      }
    }

    function pushError(msg: string) {
      if (!erroresEl) return;
      erroresEl.style.display = "grid";
      const div = document.createElement("div");
      div.setAttribute("style", "padding:0.75rem 1rem;background:#FFE5E5;border:2px solid #111;border-radius:12px;box-shadow:3px 3px 0 #111;font-size:0.9rem;display:flex;gap:0.5rem;align-items:flex-start;");
      div.innerHTML = `<span aria-hidden="true">⚠️</span><span style="flex:1;">${msg}</span><button class="mono" style="background:white;border:1.5px solid #111;border-radius:999px;padding:2px 10px;cursor:pointer;font-weight:700;font-size:0.75rem;flex-shrink:0;" onclick="this.parentElement.remove()">Cerrar</button>`;
      erroresEl.appendChild(div);
    }

    function render() {
      if (!lista || !emptyEl || !controlsEl || !resumenEl) return;
      lista.innerHTML = "";
      if (facturas.length === 0) {
        emptyEl.style.display = "block";
        controlsEl.style.display = "none";
        resumenEl.textContent = "";
        return;
      }
      emptyEl.style.display = "none";
      controlsEl.style.display = "grid";
      const pal = getPalette();
      resumenEl.innerHTML = `${facturas.length} archivo(s) listo(s) · <span style="display:inline-block;width:10px;height:10px;border-radius:999px;background:${pal.primary};border:1.5px solid var(--border);vertical-align:middle;margin:0 4px;"></span> ${pal.label} · ${branding.font} · Formato: ${formatoSel.value === "carta" ? "Carta" : formatoSel.value === "media" ? "Media Carta" : "Ticket 80mm"}`;

      facturas.forEach((f, idx) => {
        const displayName = branding.businessName?.trim() || f.emisorNombre || "—";
        const logoForCard = branding.iconMode === "upload" ? branding.logoBase64 : branding.iconMode === "avatar" ? generateAvatarBase64(displayName, pal.primary) : null;
        const card = document.createElement("div");
        card.setAttribute("style", "display:grid;gap:0.65rem;padding:1rem;background:var(--surface);border:2px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);");
        card.innerHTML = `
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;justify-content:space-between;align-items:flex-start;">
            <div style="display:flex;gap:0.6rem;align-items:center;min-width:0;flex:1;">
              ${logoForCard ? `<img src="${logoForCard}" alt="logo" style="width:40px;height:40px;object-fit:contain;background:white;border:2px solid var(--border);border-radius:10px;box-shadow:2px 2px 0 var(--border);flex-shrink:0;" />` : ""}
              <div style="display:grid;gap:0.15rem;min-width:0;flex:1;">
                <p class="mono" style="font-size:0.72rem;font-weight:800;letter-spacing:0.04em;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${f.fileName} ${f.serie || f.numero ? "· " + (f.serie ?? "") + " " + (f.numero ?? "") : ""}</p>
                <p style="font-weight:800;font-size:0.98rem;letter-spacing:-0.01em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${displayName} <span style="font-weight:400;color:var(--text-muted);">→</span> ${f.receptorNombre ?? "—"}</p>
                <p class="mono" style="font-size:0.75rem;color:var(--text-muted);">NIT Emisor: ${f.emisorNIT ?? "—"} · NIT Receptor: ${f.receptorNIT ?? "—"} ${f.fechaEmision ? "· " + f.fechaEmision.slice(0, 10) : ""}</p>
              </div>
            </div>
            <span class="mono" style="background:${pal.primary};color:white;border:1.5px solid var(--border);border-radius:999px;padding:4px 10px;font-weight:800;font-size:0.8rem;box-shadow:2px 2px 0 var(--border);white-space:nowrap;">${formatMoney(f.granTotal, f.moneda ?? "GTQ")}</span>
          </div>
          <div style="overflow:auto;border:1.5px solid var(--border);border-radius:10px;">
            <table class="mono" style="width:100%;border-collapse:collapse;font-size:0.75rem;min-width:420px;">
              <thead><tr style="background:${pal.primary};color:white;text-align:left;"><th style="padding:6px 8px;border-bottom:1.5px solid var(--border);">Descripción</th><th style="padding:6px 8px;border-bottom:1.5px solid var(--border);text-align:center;">Cant.</th><th style="padding:6px 8px;border-bottom:1.5px solid var(--border);text-align:right;">Precio</th><th style="padding:6px 8px;border-bottom:1.5px solid var(--border);text-align:right;">Total</th></tr></thead>
              <tbody>
                ${f.items.slice(0, 12).map(it => `<tr><td style="padding:6px 8px;border-bottom:1px solid #eee;max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${it.descripcion}</td><td style="padding:6px 8px;border-bottom:1px solid #eee;text-align:center;">${it.cantidad}</td><td style="padding:6px 8px;border-bottom:1px solid #eee;text-align:right;">${it.precio ? formatMoney(it.precio, f.moneda ?? "GTQ") : "—"}</td><td style="padding:6px 8px;border-bottom:1px solid #eee;text-align:right;">${it.total ? formatMoney(it.total, f.moneda ?? "GTQ") : "—"}</td></tr>`).join("")}
                ${f.items.length > 12 ? `<tr><td colspan="4" style="padding:6px 8px;text-align:center;color:var(--text-muted);">… y ${f.items.length - 12} ítem(s) más (ver PDF completo)</td></tr>` : ""}
              </tbody>
            </table>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
            <button data-idx="${idx}" data-action="download" class="brutal-btn brutal-btn--primary" style="flex:1;min-width:160px;background:${pal.primary};color:white;border-color:var(--border);">⬇️ Descargar PDF</button>
            <button data-idx="${idx}" data-action="remove" class="brutal-btn brutal-btn--ghost" style="min-width:88px;">Quitar</button>
          </div>
        `;
        lista.appendChild(card);
      });

      lista.querySelectorAll<HTMLButtonElement>("button[data-action]").forEach((b) => {
        b.addEventListener("click", () => {
          const idx = Number(b.getAttribute("data-idx"));
          const action = b.getAttribute("data-action");
          if (action === "remove") {
            facturas.splice(idx, 1);
            render();
          } else if (action === "download") {
            const fmt = formatoSel.value;
            downloadFactura(facturas[idx], fmt);
          }
        });
      });
    }

    async function handleFiles(fileList: FileList | File[]) {
      const files = Array.from(fileList).filter((f) => f.name.toLowerCase().endsWith(".xml") || f.type.includes("xml") || true);
      if (files.length === 0) {
        pushError("No se detectaron archivos XML. Asegúrate de seleccionar archivos .xml del SAT.");
        return;
      }
      for (const file of files) {
        if (!file.name.toLowerCase().endsWith(".xml")) {
          console.warn("Archivo sin extensión .xml:", file.name);
        }
        try {
          const text = await file.text();
          const fac = parseXML(text, file.name);
          const existing = facturas.findIndex((f) => f.fileName === file.name);
          if (existing >= 0) facturas[existing] = fac;
          else facturas.push(fac);
        } catch (e) {
          pushError(`<strong>${file.name}</strong>: ${(e as Error).message}`);
        }
      }
      render();
      refreshAvatarPreview();
    }

    dropInput?.addEventListener("change", () => {
      if (dropInput.files && dropInput.files.length) handleFiles(dropInput.files);
      dropInput.value = "";
    });

    dropZone?.addEventListener("dropzone:files", ((e: CustomEvent) => {
      if (e.detail?.files) handleFiles(e.detail.files);
    }) as EventListener);

    formatoSel?.addEventListener("change", render);

    btnLimpiar?.addEventListener("click", () => {
      facturas = [];
      if (erroresEl) { erroresEl.innerHTML = ""; erroresEl.style.display = "none"; }
      render();
    });

    btnTodos?.addEventListener("click", async () => {
      if (facturas.length === 0) return;
      const fmt = formatoSel.value;
      await getPdfMake();
      let i = 0;
      const next = () => {
        if (i >= facturas.length) return;
        downloadFactura(facturas[i], fmt);
        i++;
        setTimeout(next, 600);
      };
      next();
    });

    // Init branding after DOM ready
    initBrandingUI();

    // Responsive palette grid: 2 cols mobile, 3 cols >640px
    const style = document.createElement("style");
    style.textContent = "@media(min-width:640px){#palette-grid{grid-template-columns:repeat(3,1fr)!important;}#icon-options{grid-template-columns:repeat(3,1fr)!important;}}";
    document.head.appendChild(style);
  </script>
</Layout>
