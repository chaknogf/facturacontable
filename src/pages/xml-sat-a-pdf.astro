---
import Layout from "../layouts/Layout.astro";
import AdBanner from "../components/AdBanner.astro";
import Dropzone from "../components/Dropzone.astro";

const title = "XML a PDF Multi-País — SAT Guatemala, CFDI México, DIAN Colombia, SUNAT Perú, SRI Ecuador | UBL LATAM";
const description =
  "Convierte gratis tu XML electrónico (FEL Guatemala, CFDI 4.0 México, DIAN Colombia, SUNAT Perú, SRI Ecuador, UBL LATAM) a PDF profesional Carta, Media Carta y Ticket 80mm. Parser 100% en tu navegador, sin subir datos.";
---

<Layout
  title={title}
  description={description}
  keywords="XML a PDF, SAT Guatemala, FEL, CFDI México, DIAN Colombia, SUNAT Perú, SRI Ecuador, UBL, factura electrónica LATAM, XML a PDF, SAT PDF, ticket 80mm"
>
  <div class="container" style="padding-top:1rem;">
    <!-- Breadcrumb + H1 -->
    <nav class="mono" style="font-size:0.8rem;color:var(--text-muted);margin-top:1rem;display:flex;gap:0.4rem;flex-wrap:wrap;">
      <a href="/" style="text-decoration:underline;">Inicio</a><span>›</span><span style="font-weight:700;color:var(--text);">XML SAT → PDF</span>
    </nav>

    <div style="margin-top:0.75rem;display:grid;gap:0.6rem;">
      <h1 style="font-size:clamp(1.6rem,4.5vw,2.4rem);font-weight:800;line-height:1.08;letter-spacing:-0.03em;">
        XML electrónico <span style="background:var(--primary);border:2px solid var(--border);border-radius:10px;padding:0 0.3em;box-shadow:2px 2px 0 var(--border);">→ PDF</span> multi-país
      </h1>
      <p style="color:var(--text-muted);font-size:clamp(0.95rem,2.5vw,1.05rem);max-width:70ch;line-height:1.5;">
        Arrastra tu <strong style="color:var(--text);">XML UBL / CFDI / FEL / DTE</strong> de <strong style="color:var(--text);" id="hero-pais-label">Guatemala, México, Colombia, Perú, Ecuador o LATAM</strong> y descarga el PDF en <strong style="color:var(--text);">Carta, Media Carta o Ticket 80mm</strong>. 100% privado — <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">DOMParser</code> + <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">pdfmake</code> sin subir datos.
      </p>
      <div id="hero-badges" style="display:flex;flex-wrap:wrap;gap:0.5rem;font-size:0.8rem;">
        <span class="mono" style="background:var(--accent-2);border:1.5px solid var(--border);border-radius:999px;padding:3px 10px;box-shadow:2px 2px 0 var(--border);font-weight:700;">🔒 0 servidor</span>
        <span id="badge-moneda" class="mono" style="background:var(--surface);border:1.5px solid var(--border);border-radius:999px;padding:3px 10px;box-shadow:2px 2px 0 var(--border);">Q · GTQ · NIT</span>
        <span id="badge-impuesto" class="mono" style="background:var(--surface);border:1.5px solid var(--border);border-radius:999px;padding:3px 10px;box-shadow:2px 2px 0 var(--border);">IVA 12%</span>
        <span class="mono" style="background:var(--surface);border:1.5px solid var(--border);border-radius:999px;padding:3px 10px;box-shadow:2px 2px 0 var(--border);">UBL ·CFDI ·FEL</span>
      </div>
    </div>

    <!-- Selector País Neo-Brutalista Píldora/Tabs (táctil 48px) — antes de dropzone -->
    <div class="brutal-card" style="margin-top:1rem;padding:0.9rem;display:grid;gap:0.6rem;">
      <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;justify-content:space-between;">
        <span class="mono" style="font-size:0.78rem;font-weight:800;letter-spacing:0.06em;">🌎 PAÍS / FORMATO XML</span>
        <span id="country-auto-hint" class="mono" style="font-size:0.7rem;color:var(--text-muted);background:var(--bg-soft);border:1.5px solid var(--border);border-radius:999px;padding:2px 8px;">Auto-detecta por XML</span>
      </div>
      <div id="country-switch" style="display:flex;flex-wrap:wrap;gap:0.5rem;" role="tablist" aria-label="Selector de país">
        <!-- JS inject pills -->
      </div>
      <p class="mono" style="font-size:0.7rem;color:var(--text-muted);">Toca un país o deja en Auto — el parser detecta el namespace (<code style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 4px;">sat.gob.gt</code>, <code style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 4px;">sat.gob.mx/cfd</code>, <code style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 4px;">ubl</code>) y adapta moneda/ID/impuesto.</p>
      <select id="country-select" class="brutal-input" style="display:none;" aria-label="Selector país (fallback)"></select>
    </div>

    <!-- Banner Superior (Above the Fold): debajo del selector -->
    <AdBanner slot="3333333333" format="horizontal" location="XML a PDF — Hero / Above the Fold" label="PUBLICIDAD" />

    <!-- APP -->
    <section id="app" style="margin-top:1.25rem;display:grid;gap:1rem;">
      <Dropzone id="xml-dropzone" accept=".xml" multiple={true} label="Arrastra tus XML del SAT aquí" hint="o toca para seleccionar · puedes cargar varios a la vez" />

      <!-- ====== BRANDING PANEL (Client-Side Branding) ====== -->
      <div
        id="branding-panel"
        class="brutal-card"
        style="padding:1rem;display:grid;gap:1rem;background:var(--surface);"
      >
        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;flex-wrap:wrap;">
          <div style="display:flex;align-items:center;gap:0.6rem;">
            <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;background:var(--primary);border:2px solid var(--border);border-radius:10px;box-shadow:2px 2px 0 var(--border);font-size:1.1rem;">🎨</span>
            <div>
              <h2 style="font-size:1.05rem;font-weight:800;letter-spacing:-0.01em;line-height:1;">Personaliza tu marca</h2>
              <p class="mono" style="font-size:0.72rem;color:var(--text-muted);">Se aplica a todos los PDFs · 100% en tu navegador</p>
            </div>
          </div>
          <span class="mono" style="font-size:0.68rem;font-weight:800;letter-spacing:0.06em;background:var(--accent-2);border:1.5px solid var(--border);border-radius:999px;padding:4px 10px;box-shadow:2px 2px 0 var(--border);">CLIENT-SIDE</span>
        </div>

        <!-- Paletas -->
        <div style="display:grid;gap:0.5rem;">
          <label class="mono" style="font-size:0.78rem;font-weight:800;letter-spacing:0.06em;">PALETA DE COLORES</label>
          <div id="palette-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:0.5rem;">
            <!-- JS inject buttons -->
          </div>
          <p class="mono" style="font-size:0.7rem;color:var(--text-muted);">Toca una paleta — vista previa instantánea.</p>
        </div>

        <!-- Tipografía + Nombre -->
        <div style="display:grid;gap:0.75rem;">
          <div style="display:grid;gap:0.4rem;">
            <label for="branding-font" class="mono" style="font-size:0.78rem;font-weight:800;letter-spacing:0.06em;">TIPOGRAFÍA DEL PDF</label>
            <select id="branding-font" class="brutal-input" style="font-weight:700;cursor:pointer;">
              <option value="Roboto">Roboto — Limpia (predeterminada)</option>
              <option value="Helvetica">Helvetica — Moderna</option>
              <option value="Courier">Courier — Recibo térmico retro</option>
              <option value="Times">Times — Clásica y formal</option>
              <option value="OpenSans">Open Sans — Humanista</option>
            </select>
          </div>

          <div style="display:grid;gap:0.4rem;">
            <label for="branding-name" class="mono" style="font-size:0.78rem;font-weight:800;letter-spacing:0.06em;">NOMBRE DEL NEGOCIO (opcional)</label>
            <input
              id="branding-name"
              type="text"
              class="brutal-input"
              placeholder="Ej. Mi Tiendita Express"
              maxlength="60"
              autocomplete="organization"
              inputmode="text"
            />
            <span class="mono" style="font-size:0.7rem;color:var(--text-muted);">Si lo llenas, reemplaza el nombre comercial del XML en el PDF.</span>
          </div>
        </div>

        <!-- Icono Emisor -->
        <div style="display:grid;gap:0.5rem;">
          <span class="mono" style="font-size:0.78rem;font-weight:800;letter-spacing:0.06em;">IDENTIDAD VISUAL / ICONO</span>
          <div id="icon-options" style="display:grid;grid-template-columns:1fr;gap:0.5rem;">
            <label class="brutal-card" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;cursor:pointer;box-shadow:var(--shadow-sm);">
              <input type="radio" name="branding-icon" value="none" checked style="width:18px;height:18px;accent-color:var(--border);" />
              <span style="font-size:1.1rem;">🚫</span>
              <div style="display:grid;">
                <span style="font-weight:800;font-size:0.92rem;">Sin icono</span>
                <span class="mono" style="font-size:0.72rem;color:var(--text-muted);">Diseño purista, sin logo</span>
              </div>
            </label>

            <label class="brutal-card" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;cursor:pointer;box-shadow:var(--shadow-sm);">
              <input type="radio" name="branding-icon" value="avatar" style="width:18px;height:18px;accent-color:var(--border);" />
              <span style="font-size:1.1rem;">🔤</span>
              <div style="display:grid;">
                <span style="font-weight:800;font-size:0.92rem;">Avatar con iniciales</span>
                <span class="mono" style="font-size:0.72rem;color:var(--text-muted);">Generado en &lt;canvas&gt; con tu paleta</span>
              </div>
            </label>

            <label class="brutal-card" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;cursor:pointer;box-shadow:var(--shadow-sm);">
              <input type="radio" name="branding-icon" value="upload" style="width:18px;height:18px;accent-color:var(--border);" />
              <span style="font-size:1.1rem;">🖼️</span>
              <div style="display:grid;">
                <span style="font-weight:800;font-size:0.92rem;">Subir imagen</span>
                <span class="mono" style="font-size:0.72rem;color:var(--text-muted);">PNG/JPG → Base64 en el navegador</span>
              </div>
            </label>
          </div>

          <!-- Sub-controles icono -->
          <div id="avatar-preview-wrap" style="display:none;align-items:center;gap:0.75rem;padding:0.75rem;background:var(--bg-soft);border:2px solid var(--border);border-radius:var(--radius-sm);box-shadow:var(--shadow-sm);">
            <canvas id="avatar-canvas" width="200" height="200" style="width:56px;height:56px;border:2px solid var(--border);border-radius:12px;box-shadow:2px 2px 0 var(--border);flex-shrink:0;"></canvas>
            <div style="display:grid;gap:0.15rem;">
              <span class="mono" style="font-size:0.72rem;font-weight:800;">Vista previa avatar</span>
              <span id="avatar-initials-label" class="mono" style="font-size:0.75rem;color:var(--text-muted);">—</span>
            </div>
          </div>

          <div id="upload-wrap" style="display:none;gap:0.5rem;">
            <label for="branding-logo-input" class="brutal-btn brutal-btn--ghost" style="width:100%;cursor:pointer;">
              📁 Seleccionar PNG/JPG (máx 800KB)
            </label>
            <input id="branding-logo-input" type="file" accept="image/png,image/jpeg,image/webp" hidden />
            <div id="upload-preview-wrap" style="display:none;align-items:center;gap:0.75rem;padding:0.75rem;background:var(--bg-soft);border:2px solid var(--border);border-radius:var(--radius-sm);box-shadow:var(--shadow-sm);">
              <img id="upload-preview" alt="Preview logo" style="width:56px;height:56px;object-fit:contain;background:white;border:2px solid var(--border);border-radius:12px;box-shadow:2px 2px 0 var(--border);" />
              <div style="display:grid;gap:0.15rem;flex:1;min-width:0;">
                <span class="mono" style="font-size:0.72rem;font-weight:800;">Logo cargado</span>
                <span id="upload-name" class="mono" style="font-size:0.72rem;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"></span>
                <button id="btn-remove-logo" type="button" class="mono" style="justify-self:start;background:var(--surface);border:1.5px solid var(--border);border-radius:999px;padding:3px 10px;font-size:0.72rem;font-weight:700;cursor:pointer;box-shadow:1.5px 1.5px 0 var(--border);">Quitar</button>
              </div>
            </div>
            <p class="mono" style="font-size:0.7rem;color:var(--text-muted);">Se convierte a Base64 localmente — nunca sale de tu dispositivo.</p>
          </div>
        </div>

        <!-- Preview branding strip -->
        <div id="branding-preview" class="mono" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border:2px dashed var(--border);border-radius:var(--radius-sm);background:var(--bg-soft);font-size:0.8rem;">
          <span style="font-weight:800;">Vista previa:</span>
          <span id="branding-preview-dot" style="width:14px;height:14px;border-radius:999px;border:2px solid var(--border);display:inline-block;flex-shrink:0;"></span>
          <span id="branding-preview-text" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;">—</span>
          <span id="branding-preview-font" style="font-size:0.7rem;opacity:0.8;"></span>
        </div>
      </div>

      <!-- Banner Alta Conversión (CRÍTICO): entre personalización y botón Descargar PDF -->
      <AdBanner slot="4444444444" format="horizontal" location="XML a PDF — Conversión (entre personalización y Descargar PDF)" label="PUBLICIDAD" />

      <!-- Controles de formato + acciones -->
      <div
        id="controls"
        style="display:none;gap:0.75rem;padding:1rem;background:var(--surface);border:2px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);"
      >
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:end;justify-content:space-between;">
          <div style="display:grid;gap:0.4rem;flex:1;min-width:220px;">
            <label for="formato" class="mono" style="font-size:0.8rem;font-weight:800;letter-spacing:0.06em;">FORMATO DE SALIDA</label>
            <select
              id="formato"
              class="brutal-input"
              style="max-width:320px;font-weight:700;cursor:pointer;"
            >
              <option value="carta">📄 Carta Completa (Letter)</option>
              <option value="media">📃 Media Carta (A5 apaisado)</option>
              <option value="ticket">🧾 Ticket 80mm (térmico) — minimalista</option>
            </select>
            <span class="mono" style="font-size:0.72rem;color:var(--text-muted);">Se aplica a todos los archivos + tu marca.</span>
          </div>

          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
            <button id="btn-descargar-todos" class="brutal-btn brutal-btn--primary" style="flex:1;min-width:200px;">
              ⬇️ Descargar todos
            </button>
            <button id="btn-limpiar" class="brutal-btn brutal-btn--ghost">Limpiar</button>
          </div>
        </div>

        <p id="resumen" class="mono" style="font-size:0.82rem;color:var(--text-muted);"></p>
      </div>

      <!-- Lista de archivos parseados -->
      <div id="lista" style="display:grid;gap:0.75rem;"></div>

      <!-- Estado vacío -->
      <div
        id="empty"
        style="padding:1rem;background:var(--bg-soft);border:2px dashed var(--border);border-radius:var(--radius);text-align:center;color:var(--text-muted);font-size:0.9rem;"
      >
        Aún no has cargado ningún XML. Prueba con un ejemplo de SAT (GT), CFDI (MX), DIAN (CO), SUNAT (PE) o SRI (EC) — el país se detecta automáticamente.
      </div>

      <!-- Errores -->
      <div id="errores" style="display:none;gap:0.5rem;"></div>
    </section>

    <!-- Banner In-Feed SEO: antes del contenido explicativo -->
    <AdBanner slot="5555555555" format="rectangle" location="XML a PDF — SEO Pre-Contenido (antes del artículo)" label="PUBLICIDAD" />

    <!-- CONTENIDO SEO 300-400+ palabras -->
    <article
      style="margin-top:1.5rem;display:grid;gap:1.5rem;padding:1.5rem;background:var(--surface);border:2px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);"
    >
      <header style="display:grid;gap:0.5rem;">
        <h2 id="seo-title" style="font-size:1.45rem;font-weight:800;letter-spacing:-0.02em;line-height:1.2;">
          Guía completa: cómo descargar tu XML y convertirlo a PDF — SAT Guatemala, CFDI México, DIAN Colombia, SUNAT Perú, SRI Ecuador y UBL LATAM
        </h2>
        <p class="mono" style="font-size:0.78rem;color:var(--text-muted);">
          Actualizado septiembre 2026 · Lectura 6 min · Para contadores y pymes en LATAM · <span id="seo-pais-tag">🇬🇹 Guatemala · 🇲🇽 México · 🇨🇴 Colombia · 🇵🇪 Perú · 🇪🇨 Ecuador · 🌎 UBL</span>
        </p>
      </header>

      <div id="seo-content" style="display:grid;gap:1rem;line-height:1.65;color:var(--text-muted);font-size:0.98rem;">
        <p>
          La facturación electrónica es obligatoria en toda LATAM con el estándar <strong style="color:var(--text);">UBL 2.1</strong> y variantes locales: <strong style="color:var(--text);">FEL (SAT Guatemala)</strong>, <strong style="color:var(--text);">CFDI 4.0 (SAT México)</strong>, <strong style="color:var(--text);">Factura Electrónica DIAN (Colombia)</strong>, <strong style="color:var(--text);">SUNAT (Perú)</strong> y <strong style="color:var(--text);">SRI (Ecuador)</strong>. En todos los casos el <strong style="color:var(--text);">XML</strong> es el original legal (DTE, UUID, CUFE, autorización) y el PDF es solo su representación. Esta herramienta convierte cualquier XML a PDF Carta/Media/Ticket sin subir datos.
        </p>

        <h3 style="font-size:1.15rem;font-weight:800;color:var(--text);margin-top:0.25rem;">Paso a paso por país: dónde descargar tu XML</h3>
        <ol style="padding-left:1.25rem;display:grid;gap:0.55rem;">
          <li>
            <strong style="color:var(--text);">🇬🇹 Guatemala — SAT / FEL:</strong> <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">agenciavirtual.sat.gob.gt</code> → FEL → Consulta DTE → descarga XML. También viene adjunto del certificador (Infile/Digifact).
          </li>
          <li>
            <strong style="color:var(--text);">🇲🇽 México — CFDI 4.0:</strong> <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">portal.sat.gob.mx</code> → Factura electrónica → Cancela y recupera → descarga XML con <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">cfdi:Comprobante</code> y <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">tfd:TimbreFiscalDigital UUID</code>.
          </li>
          <li>
            <strong style="color:var(--text);">🇨🇴 Colombia — DIAN UBL:</strong> <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">dian.gov.co</code> → Facturando electrónicamente → descarga <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">Invoice</code> UBL con <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">cbc:ID</code> / CUFE.
          </li>
          <li>
            <strong style="color:var(--text);">🇵🇪 Perú — SUNAT UBL:</strong> <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">sunat.gob.pe</code> → SEE-SOL / OSE → descarga Invoice UBL con IGV 18%.
          </li>
          <li>
            <strong style="color:var(--text);">🇪🇨 Ecuador — SRI:</strong> <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">sri.gob.ec</code> → Comprobantes electrónicos → descarga <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">autorizacion</code> / <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">factura</code> con número de autorización.
          </li>
          <li>
            <strong style="color:var(--text);">🌎 LATAM General — UBL 2.1:</strong> cualquier <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">Invoice</code> UBL con <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">cac:AccountingSupplierParty</code> se parsea automáticamente.
          </li>
        </ol>

        <h3 style="font-size:1.15rem;font-weight:800;color:var(--text);">Casos de uso reales</h3>
        <ul style="padding-left:1.25rem;display:grid;gap:0.4rem;">
          <li><strong style="color:var(--text);">Contadores:</strong> convierten lotes de XML a PDF Carta para archivo físico y a Ticket 80mm para grapas de entrega.</li>
          <li><strong style="color:var(--text);">Pymes con POS térmico:</strong> imprimen el ticket 80mm directo en impresora térmica sin desperdiciar papel carta.</li>
          <li><strong style="color:var(--text);">Auditoría:</strong> generan Media Carta para anexar a expedientes sin ocupar una hoja completa por factura.</li>
          <li><strong style="color:var(--text);">Envío a clientes:</strong> reimprimen un PDF limpio cuando el del certificador trae marca de agua o formato ilegible.</li>
        </ul>

        <div style="background:var(--primary);border:2px solid var(--border);border-radius:var(--radius-sm);box-shadow:var(--shadow-sm);padding:1rem;display:grid;gap:0.4rem;">
          <p style="font-weight:800;color:var(--text);">🔒 Privacidad garantizada</p>
          <p style="color:var(--text-muted);font-size:0.92rem;">
