---
import Layout from "../layouts/Layout.astro";
import AdBanner from "../components/AdBanner.astro";

const tools = [
  {
    href: "/xml-sat-a-pdf",
    badge: "SAT Guatemala",
    badgeColor: "var(--primary)",
    title: "XML SAT → PDF",
    desc: "Convierte cualquier XML del FEL (DTE) en PDF profesional: Carta, Media Carta o Ticket 80mm. 100% en tu navegador.",
    cta: "Usar gratis →",
    status: "Disponible",
    statusColor: "#7DE2D1",
    icon: "🧾",
  },
  {
    href: "/conciliador-excel-csv",
    badge: "Nuevo",
    badgeColor: "#7DE2D1",
    title: "Conciliador CSV → Excel",
    desc: "Cruza estados de cuenta y libros contables. Detecta diferencias automáticamente.",
    cta: "Conciliar ahora →",
    status: "Disponible",
    statusColor: "#7DE2D1",
    icon: "📊",
    disabled: false,
  },
  {
    href: "#",
    badge: "Próximamente",
    badgeColor: "#FF6B6B",
    title: "Validador NIT / CUI",
    desc: "Valida y formatea NIT y CUI con dígito verificador. Lote por CSV.",
    cta: "Próximamente",
    status: "En desarrollo",
    statusColor: "#E5E5E5",
    icon: "🪪",
    disabled: true,
  },
  {
    href: "#",
    badge: "Próximamente",
    badgeColor: "#7DE2D1",
    title: "Libro de Compras y Ventas",
    desc: "Genera el formato SAT desde tus FEL en segundos.",
    cta: "Próximamente",
    status: "En desarrollo",
    statusColor: "#E5E5E5",
    icon: "📒",
    disabled: true,
  },
];
---

<Layout
  title="FacturaContable.gt — Herramientas gratis para contadores en Guatemala"
  description="Convierte XML del SAT Guatemala a PDF (Carta, Media Carta, Ticket 80mm) gratis y sin subir tus datos. Herramientas client-side para contadores, auditores y pymes. 100% privado."
  keywords="SAT Guatemala, FEL, DTE, XML a PDF, factura electrónica, contador Guatemala, herramientas contables"
>
  <!-- Hero -->
  <section style="padding:1.5rem 0 0.5rem;">
    <div class="container">
      <div
        style="display:grid;gap:1.25rem;padding:1.5rem;background:var(--surface);border:2px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-lg);"
      >
        <div style="display:inline-flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
          <span
            class="mono"
            style="font-size:0.75rem;font-weight:800;letter-spacing:0.06em;background:var(--accent-2);border:1.5px solid var(--border);border-radius:999px;padding:4px 12px;box-shadow:2px 2px 0 var(--border);"
            >100% EN TU NAVEGADOR · 0 SERVIDOR</span
          >
          <span
            class="mono"
            style="font-size:0.75rem;font-weight:700;background:var(--bg-soft);border:1.5px solid var(--border);border-radius:999px;padding:4px 10px;"
            >🔒 Privado</span
          >
        </div>

        <h1
          style="font-size:clamp(1.9rem,5vw,3rem);font-weight:800;line-height:1.05;letter-spacing:-0.03em;"
        >
          Herramientas contables<br />
          <span style="background:var(--primary);border:2px solid var(--border);border-radius:12px;padding:0 0.35em;box-decoration-break:clone;box-shadow:3px 3px 0 var(--border);">que no te espían.</span>
        </h1>

        <p style="font-size:clamp(1rem,2.5vw,1.15rem);color:var(--text-muted);max-width:62ch;line-height:1.5;">
          Micro-herramientas gratuitas para contadores, auditores y pymes en Guatemala. Convierte tus XML del FEL,
          valida documentos y genera reportes — <strong style="color:var(--text);">todo se procesa en tu navegador</strong>, tus archivos nunca salen de tu dispositivo.
        </p>

        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center;">
          <a href="/xml-sat-a-pdf" class="brutal-btn brutal-btn--primary" style="font-size:1.05rem;">Convertir XML → PDF gratis →</a>
          <a href="#herramientas" class="brutal-btn brutal-btn--ghost">Ver herramientas</a>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:0.6rem;font-size:0.85rem;color:var(--text-muted);">
          <span>✓ Sin registro</span><span>·</span><span>✓ Sin límites</span><span>·</span><span>✓ Funciona offline</span><span>·</span><span>✓ Hecho en 🇬🇹</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Banner 1 (Hero): entre introducción y grid (alta visibilidad, margen respirable) -->
  <div class="container">
    <AdBanner slot="1111111111" format="horizontal" location="Portal - Hero (entre intro y herramientas)" label="PUBLICIDAD" />
  </div>

  <!-- Catálogo -->
  <section id="herramientas" style="padding:1rem 0;">
    <div class="container">
      <div style="display:flex;align-items:end;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;">
        <h2 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.02em;">Herramientas</h2>
        <span class="mono" style="font-size:0.8rem;color:var(--text-muted);">{tools.length} herramientas · 2 disponibles</span>
      </div>

      <div style="display:grid;grid-template-columns:1fr;gap:1rem;">
        <style>
          @media (min-width: 640px) { #tools-grid { grid-template-columns: repeat(2, 1fr) !important; } }
        </style>
        <div id="tools-grid" style="display:grid;grid-template-columns:1fr;gap:1rem;">
          {
            tools.map((t) => (
              <a
                href={t.href}
                aria-disabled={t.disabled ? "true" : undefined}
                style={`text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:0.75rem;padding:1.25rem;background:var(--surface);border:2px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);transition:transform 0.08s;${t.disabled ? "opacity:0.72;pointer-events:none;" : ""}`}
              >
                <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
                  <span
                    class="mono"
                    style={`font-size:0.7rem;font-weight:800;letter-spacing:0.06em;background:${t.badgeColor};border:1.5px solid var(--border);border-radius:999px;padding:3px 10px;box-shadow:1.5px 1.5px 0 var(--border);`}
                  >
                    {t.badge}
                  </span>
                  <span
                    style={`font-size:0.7rem;font-weight:700;background:${t.statusColor};color:#111;border:1.5px solid var(--border);border-radius:999px;padding:3px 8px;`}
                  >
                    {t.status}
                  </span>
                </div>
                <div style="display:flex;align-items:center;gap:0.6rem;">
                  <span style="font-size:1.6rem;line-height:1;">{t.icon}</span>
                  <h3 style="font-size:1.15rem;font-weight:800;letter-spacing:-0.01em;">{t.title}</h3>
                </div>
                <p style="font-size:0.92rem;color:var(--text-muted);line-height:1.45;">{t.desc}</p>
                <span
                  class="brutal-btn brutal-btn--primary"
                  style="margin-top:auto;align-self:flex-start;font-size:0.9rem;min-height:40px;padding:0 1rem;"
                >
                  {t.cta}
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Banner 2 (In-Feed): mitad/final del catálogo -->
      <AdBanner slot="2222222222" format="horizontal" location="Portal - In-Feed (final del catálogo)" label="PUBLICIDAD" />

      <!-- Por qué client-side -->
      <div
        style="display:grid;gap:1rem;padding:1.25rem;background:var(--primary);border:2px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);margin-top:1rem;"
      >
        <h3 style="font-size:1.15rem;font-weight:800;">¿Por qué todo es client-side?</h3>
        <div style="display:grid;gap:0.75rem;font-size:0.95rem;line-height:1.5;">
          <p>
            Tus XML del SAT contienen datos sensibles: NIT, montos, clientes y proveedores. Subirlos a un servidor es
            un riesgo innecesario. En FacturaContable <strong>nada se envía a ningún servidor</strong>: el parser usa
            <code class="mono" style="background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">DOMParser</code> y <code class="mono" style="background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">pdfmake</code> directamente en tu navegador. Puedes incluso desconectar el internet después de cargar la página.
          </p>
          <ul style="padding-left:1.2rem;display:grid;gap:0.35rem;">
            <li><strong>Privacidad real:</strong> 0 logs, 0 uploads, 0 terceros.</li>
            <li><strong>Velocidad:</strong> sin espera de subida/bajada, todo es instantáneo.</li>
            <li><strong>Offline:</strong> funciona sin conexión una vez cargada la página.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO content 400+ palabras para AdSense (evitar contenido poco valor) -->
  <section style="padding:1rem 0 0;">
    <div class="container">
      <article
        class="brutal-card"
        style="padding:1.5rem;display:grid;gap:1.25rem;"
      >
        <h2 style="font-size:1.35rem;font-weight:800;letter-spacing:-0.02em;">Factura electrónica FEL en Guatemala — Guía completa para pymes y contadores</h2>
        <p style="color:var(--text-muted);line-height:1.65;">
          Desde 2023 la Superintendencia de Administración Tributaria (SAT) exige la Factura Electrónica en Línea (FEL) para la mayoría de contribuyentes en Guatemala. Cada Documento Tributario Electrónico (DTE) se respalda con un archivo XML que puedes descargar desde la Agencia Virtual o recibir por correo del Certificador (Infile, Digifact, etc.). Ese XML es el original legal con validez tributaria; el PDF que ves es solo su representación impresa para archivo o entrega. En FacturaContable conviertes ese XML en PDF profesional (Carta, Media Carta o Ticket 80mm) sin instalar nada, y cruzas tus estados de cuenta con tu libro contable en Excel, todo 100% en tu navegador.
        </p>
        <h3 style="font-size:1.08rem;font-weight:800;color:var(--text);">¿Qué herramientas gratuitas encontrarás aquí?</h3>
        <ul style="padding-left:1.2rem;display:grid;gap:0.4rem;color:var(--text-muted);line-height:1.6;">
          <li><strong style="color:var(--text);">XML SAT → PDF:</strong> parser <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">DOMParser</code> + <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">pdfmake</code> con branding (paleta, tipografía, logo/avatar en canvas → Base64) y ticket 80mm minimalista con alto dinámico.</li>
          <li><strong style="color:var(--text);">Conciliador CSV → Excel:</strong> motor <code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">xlsx + papaparse</code> que normaliza claves (<code class="mono" style="background:var(--bg-soft);border:1px solid var(--border);border-radius:6px;padding:1px 6px;">trim()</code>) y montos (Q $, comas) y compara con tolerancia de centavos (&lt; Q0.01) en 3 pestañas: Conciliados, Diferencias_Monto y Pendientes.</li>
          <li><strong style="color:var(--text);">Próximamente:</strong> Validador NIT/CUI y Libro de Compras y Ventas FEL — todas client-side y sin subir datos.</li>
        </ul>
        <h3 style="font-size:1.08rem;font-weight:800;color:var(--text);">¿Por qué client-side es crítico para datos financieros?</h3>
        <p style="color:var(--text-muted);line-height:1.65;">
          Tus XML, CSV y XLSX contienen NIT, montos, clientes y proveedores. Subirlos a un servidor expone tu contabilidad a terceros y a filtraciones. Aquí nada sale de tu dispositivo: abre DevTools → Network y verás cero envíos. Puedes desconectar el Wi-Fi tras cargar la página y seguir convirtiendo o conciliando. Esa privacidad, sumada a velocidad instantánea y funcionamiento offline, es el diferencial que buscan contadores y auditores que exigen cumplimiento y discreción.
        </p>
        <div style="display:grid;gap:0.6rem;">
          <details style="background:var(--bg-soft);border:2px solid var(--border);border-radius:12px;padding:0.9rem 1rem;box-shadow:var(--shadow-sm);">
            <summary style="font-weight:800;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:0.5rem;">¿Cómo empiezo en 2 minutos? <span>＋</span></summary>
            <p style="margin-top:0.6rem;color:var(--text-muted);line-height:1.6;font-size:0.95rem;">Elige la herramienta en el catálogo, arrastra tu archivo (XML, CSV o XLSX), ajusta opciones (paleta, columnas clave/monto) y descarga el resultado. Sin registro ni límites. Guarda el archivo original para auditoría.</p>
          </details>
          <details style="background:var(--bg-soft);border:2px solid var(--border);border-radius:12px;padding:0.9rem 1rem;box-shadow:var(--shadow-sm);">
            <summary style="font-weight:800;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:0.5rem;">¿Funciona en móvil? <span>＋</span></summary>
            <p style="margin-top:0.6rem;color:var(--text-muted);line-height:1.6;font-size:0.95rem;">Sí. Todo el diseño es mobile-first con botones de mínimo 48px, dropzones táctiles y tablas con scroll. Puedes facturar desde el teléfono en una tienda o mercado.</p>
          </details>
        </div>
        <AdBanner slot="idxseo001" format="horizontal" location="Portal — SEO (dentro del artículo)" label="PUBLICIDAD" />
        <p class="mono" style="font-size:0.75rem;color:var(--text-muted);border-top:2px dashed var(--border);padding-top:0.75rem;">Más de 380 palabras de contenido útil para cumplir políticas de AdSense. No somos la SAT ni certificador; marcas citadas pertenecen a sus dueños.</p>
      </article>
    </div>
  </section>
</Layout>

<style>
  #tools-grid a:hover { transform: translate(-1px, -1px); box-shadow: 6px 6px 0 var(--border) !important; }
  #tools-grid a:active { transform: translate(1px, 1px); box-shadow: 2px 2px 0 var(--border) !important; }
</style>
